# Copie este archivo como .env y reemplace los valores. No suba .env a Git.
# En Docker Desktop, SQL Server instalado en el host suele resolverse como host.docker.internal.
TRANSPORT_DB_CONNECTION=Server=host.docker.internal,1433;Database=TransPortDB;User Id=SU_USUARIO_SQL;Password=SU_CLAVE_SQL;Encrypt=True;TrustServerCertificate=True
# Genere un valor aleatorio de 32 caracteres o más; no reutilice este texto.
TRANSPORT_JWT_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
