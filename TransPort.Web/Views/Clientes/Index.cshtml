@model IReadOnlyList<ClienteListadoWebDto>
@{ ViewData["Title"] = "Clientes"; }
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Clientes</h2>
        <a asp-action="Create" class="btn btn-primary">Nuevo cliente</a>
    </div>
    @if (TempData["Ok"] is string ok) { <div class="alert alert-success">@ok</div> }
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-5"><input name="busqueda" value="@ViewBag.Busqueda" class="form-control" placeholder="Buscar..." /></div>
        <div class="col-md-3">
            <select name="esActivo" class="form-select">
                <option value="">Todos</option>
                <option value="true" selected="@(ViewBag.EsActivo == true)">Activos</option>
                <option value="false" selected="@(ViewBag.EsActivo == false)">Inactivos</option>
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-secondary w-100">Filtrar</button></div>
    </form>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Nombre</th><th>NIT</th><th>Correo</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @foreach (var c in Model) {
                <tr>
                    <td>@c.Nombre</td><td>@c.Nit</td><td>@c.CorreoContacto</td><td>@(c.EsActivo ? "Activo" : "Inactivo")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@c.ClienteId" class="btn btn-sm btn-info">Ver</a>
                        <a asp-action="Edit" asp-route-id="@c.ClienteId" class="btn btn-sm btn-warning">Editar</a>
                        <form asp-action="Delete" asp-route-id="@c.ClienteId" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar?');">
                            <button class="btn btn-sm btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted">Sin clientes.</td></tr> }
            </tbody>
        </table>
    </div>
</div>