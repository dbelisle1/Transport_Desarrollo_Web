@model ClienteDetalleWebDto
@{ ViewData["Title"] = "Detalle del cliente"; }
<div class="container mt-4">
    <h2>@Model.Nombre</h2>
    <dl class="row mt-3">
        <dt class="col-sm-3">NIT</dt><dd class="col-sm-9">@Model.Nit</dd>
        <dt class="col-sm-3">Correo</dt><dd class="col-sm-9">@Model.CorreoContacto</dd>
        <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@(Model.EsActivo ? "Activo" : "Inactivo")</dd>
    </dl>
    <h4 class="mt-4">Usuarios asociados</h4>
    @if (Model.Usuarios.Any()) { <ul>@foreach (var u in Model.Usuarios) { <li>@u.Nombre</li> }</ul> } else { <p class="text-muted">Sin usuarios.</p> }
    <h4 class="mt-4">Giros asociados</h4>
    @if (Model.Giros.Any()) { <ul>@foreach (var g in Model.Giros) { <li>@g.Nombre</li> }</ul> } else { <p class="text-muted">Sin giros.</p> }
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>