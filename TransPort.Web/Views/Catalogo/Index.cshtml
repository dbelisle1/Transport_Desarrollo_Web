@model IReadOnlyList<OfertaCatalogoModel>
@{
    ViewData["Title"] = "Catálogo comercial";
    var giros = (IReadOnlyList<CatalogoModel>)(ViewData["Giros"] ?? Array.Empty<CatalogoModel>());
    var giroId = ViewData["GiroId"] as int?;
    var tipo = ViewData["Tipo"] as string;
}
<section class="catalog-hero"><div class="container"><span class="eyebrow">Sala de ventas</span><h1>Productos y servicios de TransPort.</h1><p>Explore ofertas reales de nuestros seis giros. Los precios mostrados son una base para cotización.</p></div></section>
<section class="section"><div class="container">
    <form method="get" class="filter-bar catalog-filter">
        <div><label for="giroId">Giro de negocio</label><select id="giroId" name="giroId"><option value="">Todos</option>@foreach(var x in giros){<option value="@x.Id" selected="@(giroId==x.Id)">@x.Nombre</option>}</select></div>
        <div><label for="tipo">Tipo</label><select id="tipo" name="tipo"><option value="">Productos y servicios</option><option selected="@(tipo=="Producto")">Producto</option><option selected="@(tipo=="Servicio")">Servicio</option></select></div>
        <button class="button button-small" type="submit">Filtrar</button><a class="text-link" href="/catalogo">Limpiar</a>
    </form>
    @if(Model.Count==0){<p class="empty">No hay ofertas públicas para el filtro seleccionado.</p>}
    else{<div class="offer-grid">@foreach(var x in Model){<article class="offer-card"><span class="eyebrow">@x.Tipo · @x.Codigo</span><h2>@x.Nombre</h2><p>@x.Descripcion</p><small>@x.Giro</small><div class="offer-price"><strong>@x.PrecioBase.ToString("C2")</strong><span>por @x.UnidadMedida.ToLowerInvariant()</span></div><a class="button button-small" href="/acceso?retorno=%2Fcliente%2Fpedidos%2Fcrear">Solicitar o cotizar</a></article>}</div>}
</div></section>
