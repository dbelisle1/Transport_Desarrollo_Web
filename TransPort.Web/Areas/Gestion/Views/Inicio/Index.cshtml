@{ ViewData["Title"]="Panel de gestión"; var roles=User.Claims.Where(c=>c.Type==System.Security.Claims.ClaimTypes.Role).Select(c=>c.Value).ToArray(); var giros=User.Claims.Where(c=>c.Type=="giro").Select(c=>c.Value).ToArray(); var sedes=User.Claims.Where(c=>c.Type=="sede").Select(c=>c.Value).ToArray(); }
<section class="dashboard-page"><div class="container">
<div class="dashboard-hero"><div><span class="eyebrow">Gestión interna</span><h1>Buen día, @User.Identity?.Name</h1><p>Este panel refleja únicamente los alcances autorizados para su cuenta.</p></div><span class="status-pill">@string.Join(" · ",roles)</span></div>
<div class="scope-grid"><div class="info-panel"><span class="eyebrow">Giros autorizados</span>@if(giros.Length==0){<p>Sin asignaciones específicas.</p>}else{<div class="chip-list">@foreach(var x in giros){<span class="chip">@x</span>}</div>}</div><div class="info-panel"><span class="eyebrow">Sedes asignadas</span>@if(sedes.Length==0){<p>Sin sedes específicas.</p>}else{<div class="chip-list">@foreach(var x in sedes){<span class="chip">@x</span>}</div>}</div></div>
<div class="section-heading compact"><span class="eyebrow">Módulos</span><h2>Espacio de trabajo.</h2></div><div class="module-grid">
@if(User.IsInRole("AdministradorGeneral")||User.IsInRole("Gerente")||User.IsInRole("Vendedor")){<a class="module-card active" href="/gestion/pedidos"><span class="module-icon">▦</span><h3>Gestión comercial</h3><p>Pedidos, cotizaciones y reuniones de clientes.</p><span>Disponible</span></a>}
@if(User.IsInRole("AdministradorGeneral")||User.IsInRole("Gerente")||User.IsInRole("Empleado")||User.IsInRole("Operativo")){<a class="module-card active" href="/gestion/inventarios"><span class="module-icon">▤</span><h3>Inventarios</h3><p>Existencias, movimientos, transferencias y reservas.</p><span>Disponible</span></a>}
@if(User.IsInRole("AdministradorGeneral")||User.IsInRole("Gerente")){<a class="module-card active" href="/gestion/catalogo"><span class="module-icon">◇</span><h3>Catálogo comercial</h3><p>Productos, servicios, precios y publicación.</p><span>Disponible</span></a>}<a class="module-card active" href="/gestion/abastecimientos"><span class="module-icon">↻</span><h3>Abastecimiento</h3><p>Solicitudes programadas entre giros de negocio.</p><span>Disponible</span></a><a class="module-card active" href="/gestion/extracciones"><span class="module-icon">◆</span><h3>Extracción minera</h3><p>Jornadas, material aprovechable y destinos.</p><span>Disponible</span></a><a class="module-card active" href="/gestion/producciones"><span class="module-icon">⚙</span><h3>Producción</h3><p>Órdenes, etapas, rendimiento y costos.</p><span>Disponible</span></a><a class="module-card active" href="/gestion/maquinarias"><span class="module-icon">▣</span><h3>Maquinaria</h3><p>Equipos, contratos, devoluciones y mantenimiento.</p><span>Disponible</span></a><a class="module-card active" href="/gestion/transportes"><span class="module-icon">➜</span><h3>Transporte</h3><p>Flota, conductores, rutas, cargas e incidencias.</p><span>Disponible</span></a><a class="module-card active" href="/gestion/gps"><span class="module-icon">◎</span><h3>GPS</h3><p>Posición, recorridos, velocidad y alertas simulables.</p><span>Disponible</span></a><a class="module-card active" href="/gestion/construcciones"><span class="module-icon">⌂</span><h3>Construcción</h3><p>Obras, actividades, recursos, avances y costos.</p><span>Disponible</span></a><a class="module-card active" href="/gestion/finanzas"><span class="module-icon">$</span><h3>Presupuestos</h3><p>Asignación y gasto real por giro y sede.</p><span>Disponible</span></a><a class="module-card active" href="/gestion/alertas"><span class="module-icon">!</span><h3>Alertas</h3><p>Avisos, lectura y seguimiento por alcance.</p><span>Disponible</span></a><a class="module-card active" href="/gestion/comunicaciones"><span class="module-icon">✉</span><h3>Comunicaciones</h3><p>Consultas de clientes, notas internas y responsables.</p><span>Disponible</span></a><a class="module-card active" href="/gestion/integraciones"><span class="module-icon">⇄</span><h3>Integraciones</h3><p>Simulación REST, Webhook y CSV con trazabilidad.</p><span>Disponible</span></a>
<a class="module-card active" href="/gestion/reportes"><span class="module-icon">▥</span><h3>Reportes</h3><p>Indicadores operativos, financieros y consolidados.</p><span>Disponible</span></a>
</div></div></section>
