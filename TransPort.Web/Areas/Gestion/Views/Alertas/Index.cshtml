@model AlertaPaginaViewModel
@{ViewData["Title"]="Alertas";var ahora=DateTime.UtcNow;}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>Alertas y recordatorios</h1><p>Avisos segmentados por responsabilidad y alcance operativo.</p></div></div>
<form method="get" class="filter-bar"><select name="estado"><option value="">Todos los estados</option>@foreach(var x in new[]{"Activa","Resuelta","Cancelada"}){<option selected="@(Model.Estado==x)">@x</option>}</select><label><input type="checkbox" name="soloPendientes" value="true" checked="@Model.SoloPendientes"/> Solo pendientes</label><button class="button button-small">Filtrar</button></form>
<div class="responsive-table"><table><thead><tr><th>Aviso</th><th>Destino</th><th>Programación</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model.Alertas){<tr><td><strong>@x.Severidad · @x.Titulo</strong><small>@x.Tipo · @(x.Leida?"Leída":"Pendiente de lectura") · @x.Seguimientos seguimientos</small></td><td>@(x.UsuarioDestino??x.Rol??"Personal interno")<small>@x.Giro · @x.Sede</small></td><td>@x.FechaProgramadaUtc.ToString("dd/MM/yyyy HH:mm") UTC</td><td>@x.Estado</td><td><a href="/gestion/alertas/@x.AlertaNotificacionId">Ver</a></td></tr>}</tbody></table></div>
@if(User.IsInRole("AdministradorGeneral")||User.IsInRole("Gerente")){<form method="post" action="/gestion/alertas/crear" class="entity-form">@Html.AntiForgeryToken()<fieldset><legend>Nuevo aviso</legend><div class="form-grid"><select name="Tipo"><option>Alerta</option><option>Recordatorio</option></select><select name="Severidad"><option>Informativa</option><option>Advertencia</option><option>Critica</option></select><input name="Titulo" placeholder="Título" required/><input name="Mensaje" placeholder="Mensaje" required/><select name="RolId"><option value="">Cualquier rol interno</option>@foreach(var x in Model.Opciones.Roles){<option value="@x.Id">@x.Nombre</option>}</select><select name="GiroId"><option value="">Cualquier giro</option>@foreach(var x in Model.Opciones.Giros){<option value="@x.Id">@x.Nombre</option>}</select><select name="SedeId"><option value="">Cualquier sede</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id">@x.Nombre</option>}</select><select name="UsuarioDestinoId"><option value="">Cualquier usuario aplicable</option>@foreach(var x in Model.Opciones.Usuarios){<option value="@x.Id">@x.Nombre</option>}</select><input type="datetime-local" name="FechaProgramadaUtc" value="@ahora.ToString("yyyy-MM-ddTHH:mm")" required/><input type="datetime-local" name="FechaVencimientoUtc"/><input name="ModuloOrigen" placeholder="Módulo origen"/><input type="number" name="RegistroOrigenId" placeholder="ID origen"/></div><small>Las fechas se almacenan en UTC. Los filtros de rol, giro, sede y usuario se combinan.</small><button class="button">Crear aviso</button></fieldset></form>}</div></section>
