@model AlertaDetalleModel
@{ViewData["Title"]=Model.Titulo;}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion/alertas">← Alertas</a><h1>@Model.Titulo</h1><p>@Model.Tipo · @Model.Severidad · @Model.Estado</p></div><span class="status-pill">@(Model.Leida?"Leída":"Sin leer")</span></div><div class="info-panel"><p>@Model.Mensaje</p><small>Destino: @(Model.UsuarioDestino??Model.Rol??"Personal interno") · @Model.Giro · @Model.Sede<br/>Programada: @Model.FechaProgramadaUtc.ToString("dd/MM/yyyy HH:mm") UTC · Origen: @Model.ModuloOrigen @Model.RegistroOrigenId</small></div>
@if(!Model.Leida){<form method="post" action="/gestion/alertas/@Model.AlertaNotificacionId/leer">@Html.AntiForgeryToken()<button class="button">Confirmar lectura</button></form>}
@if(Model.Estado=="Activa"){<form method="post" action="/gestion/alertas/@Model.AlertaNotificacionId/seguimientos" class="entity-form">@Html.AntiForgeryToken()<fieldset><legend>Agregar seguimiento</legend><textarea name="comentario" placeholder="Acción realizada o novedad" required></textarea><button class="button">Guardar seguimiento</button></fieldset></form>}
<div class="responsive-table"><table><thead><tr><th>Seguimiento</th><th>Usuario</th><th>Fecha</th></tr></thead><tbody>@foreach(var x in Model.Seguimientos){<tr><td>@x.Comentario</td><td>@x.NombreUsuario</td><td>@x.Fecha.ToString("dd/MM/yyyy HH:mm")</td></tr>}</tbody></table></div>
@if(Model.Estado=="Activa"&&(User.IsInRole("AdministradorGeneral")||User.IsInRole("Gerente"))){<form method="post" action="/gestion/alertas/@Model.AlertaNotificacionId/estado" class="filter-bar">@Html.AntiForgeryToken()<button class="button button-small" name="estado" value="Resuelta">Resolver</button><button class="button button-small" name="estado" value="Cancelada">Cancelar</button></form>}@if(User.IsInRole("AdministradorGeneral")&&Model.Estado!="Activa"){<form method="post" action="/gestion/alertas/@Model.AlertaNotificacionId/eliminar">@Html.AntiForgeryToken()<button class="link-button danger">Eliminar aviso</button></form>}</div></section>
