@model MaquinariaPaginaViewModel
@{ViewData["Title"]="Maquinaria";}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>Venta y alquiler de maquinaria</h1><p>Equipos, disponibilidad, ubicación, reservas y mantenimiento.</p></div></div>@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}<form method="get" class="filter-bar client-filter"><div><label>Buscar</label><input name="busqueda" value="@Model.Busqueda"/></div><div><label>Estado</label><select name="estado"><option value="">Todos</option>@foreach(var e in new[]{"Disponible","Reservada","Alquilada","Mantenimiento","Vendida","Baja"}){<option selected="@(Model.Estado==e)">@e</option>}</select></div><div><label>Sede</label><select name="sedeId"><option value="">Todas</option>@foreach(var s in Model.Opciones.Sedes){<option value="@s.Id" selected="@(Model.SedeId==s.Id)">@s.Nombre</option>}</select></div><button class="button button-small">Filtrar</button></form><div class="responsive-table"><table><thead><tr><th>Equipo</th><th>Sede</th><th>Estado</th><th>Tarifas</th><th>Uso</th><th></th></tr></thead><tbody>@foreach(var x in Model.Equipos){<tr><td><strong>@x.Codigo · @x.Tipo</strong><small>@x.Marca @x.Modelo @x.Anio</small></td><td>@x.Sede</td><td><span class="status-pill">@x.Estado</span></td><td>Venta @x.PrecioVenta?.ToString("C2")<small>Día @x.TarifaDiaria?.ToString("C2")</small></td><td>@x.HorasUso.ToString("N2") h</td><td><a class="text-link" href="/gestion/maquinarias/@x.MaquinariaEquipoId">Ver</a></td></tr>}</tbody></table></div><div class="section-heading compact"><h2>Nuevo equipo.</h2></div><form method="post" action="/gestion/maquinarias/crear" class="entity-form">@Html.AntiForgeryToken()<div class="form-grid"><div><label>Sede</label><select name="SedeId" required>@foreach(var s in Model.Opciones.Sedes){<option value="@s.Id">@s.Nombre</option>}</select></div><div><label>Código</label><input name="Codigo" required/></div><div><label>Tipo</label><input name="Tipo" required/></div><div><label>Marca</label><input name="Marca" required/></div><div><label>Modelo</label><input name="Modelo" required/></div><div><label>Año</label><input type="number" name="Anio"/></div><div><label>Precio venta</label><input type="number" step="0.01" name="PrecioVenta"/></div><div><label>Tarifa diaria</label><input type="number" step="0.01" name="TarifaDiaria"/></div><div><label>Horas de uso</label><input type="number" step="0.01" name="HorasUso" value="0"/></div></div><button class="button">Crear equipo</button></form></div></section>
