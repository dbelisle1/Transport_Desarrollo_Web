@model MaquinariaDetalleModel
@{ViewData["Title"]=Model.Codigo;var o=(MaquinariaOpcionesModel)ViewBag.Opciones;}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion/maquinarias">← Maquinaria</a><h1>@Model.Codigo · @Model.Tipo</h1><p>@Model.Marca @Model.Modelo · @Model.Sede · @Model.HorasUso.ToString("N2") h</p></div><span class="status-pill">@Model.Estado</span></div>@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}@if(Model.Estado=="Disponible"){<div class="scope-grid"><form method="post" action="/gestion/maquinarias/@Model.MaquinariaEquipoId/contratos" class="entity-form"><fieldset><legend>Nueva reserva</legend><select name="ClienteId">@foreach(var c in o.Clientes){<option value="@c.Id">@c.Nombre</option>}</select><select name="Tipo"><option>Alquiler</option><option>Venta</option></select><input type="date" name="FechaInicio" value="@DateTime.Today.ToString("yyyy-MM-dd")"/><input type="date" name="FechaFin"/><input type="number" step="0.01" name="MontoTotal" placeholder="Monto"/><input type="number" step="0.01" name="Deposito" placeholder="Depósito"/><button class="button">Reservar</button></fieldset></form><form method="post" action="/gestion/maquinarias/@Model.MaquinariaEquipoId/mantenimientos" class="entity-form"><fieldset><legend>Programar mantenimiento</legend><input name="Tipo" placeholder="Preventivo" required/><input type="date" name="FechaProgramada" value="@DateTime.Today.ToString("yyyy-MM-dd")"/><input type="number" step="0.01" name="Costo" placeholder="Costo"/><button class="button">Programar</button></fieldset></form></div>}<div class="section-heading compact"><h2>Contratos.</h2></div><div class="responsive-table"><table><thead><tr><th>Cliente</th><th>Tipo/fechas</th><th>Monto</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var c in Model.Contratos){<tr><td>@c.Cliente</td><td>@c.Tipo<small>@c.FechaInicio.ToString("dd/MM/yy") - @c.FechaFin?.ToString("dd/MM/yy")</small></td><td>@c.MontoTotal.ToString("C2")</td><td>@c.Estado</td><td>@if(c.Estado is "Reservado" or "Activo"){<form method="post" action="/gestion/maquinarias/@Model.MaquinariaEquipoId/contratos/@c.MaquinariaContratoId"><select name="estado">@if(c.Estado=="Reservado"){<option>Activo</option>}else{<option>Finalizado</option>}<option>Cancelado</option></select><input type="number" step="0.01" name="horasDevolucion" placeholder="Horas devolución"/><button class="button button-small">Aplicar</button></form>}</td></tr>}</tbody></table></div><div class="section-heading compact"><h2>Mantenimiento.</h2></div><div class="responsive-table"><table><tbody>@foreach(var m in Model.Mantenimientos){<tr><td>@m.Tipo<small>@m.FechaProgramada.ToString("dd/MM/yyyy") · @m.Costo.ToString("C2")</small></td><td>@m.Estado</td><td>@if(m.Estado is "Programado" or "EnProceso"){<form method="post" action="/gestion/maquinarias/@Model.MaquinariaEquipoId/mantenimientos/@m.MaquinariaMantenimientoId"><select name="estado">@if(m.Estado=="Programado"){<option>EnProceso</option>}else{<option>Completado</option>}<option>Cancelado</option></select><button class="button button-small">Aplicar</button></form>}</td></tr>}</tbody></table></div>@if(User.IsInRole("AdministradorGeneral")){<form method="post" action="/gestion/maquinarias/@Model.MaquinariaEquipoId/eliminar"><button class="link-button danger">Eliminar equipo</button></form>}</div></section>
