@model ExtraccionPaginaViewModel
@{ViewData["Title"]="Extracción minera";}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>Extracción minera</h1><p>Jornadas por planta, material aprovechable y destino operativo.</p></div></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<form method="get" class="filter-bar client-filter"><div><label>Estado</label><select name="estado"><option value="">Todos</option>@foreach(var e in new[]{"Registrada","Confirmada","Entregada","Cancelada"}){<option selected="@(Model.Estado==e)">@e</option>}</select></div><div><label>Planta</label><select name="sedeId"><option value="">Todas</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id" selected="@(Model.SedeId==x.Id)">@x.Nombre</option>}</select></div><div><label>Desde</label><input type="date" name="fechaDesde" value="@Model.FechaDesde?.ToString("yyyy-MM-dd")"/></div><div><label>Hasta</label><input type="date" name="fechaHasta" value="@Model.FechaHasta?.ToString("yyyy-MM-dd")"/></div><button class="button button-small">Filtrar</button><a class="text-link" href="/gestion/extracciones">Limpiar</a></form>
<div class="responsive-table"><table><thead><tr><th>Jornada</th><th>Planta</th><th>Material</th><th>Balance</th><th>Destino</th><th>Estado</th><th></th></tr></thead><tbody>@if(Model.Jornadas.Count==0){<tr><td colspan="7" class="empty">Sin jornadas.</td></tr>}@foreach(var x in Model.Jornadas){<tr><td><strong>#@x.ExtraccionJornadaId · @x.FechaOperacion.ToString("dd/MM/yyyy")</strong><small>@x.Turno · @x.FrenteExtraccion</small></td><td>@x.Sede</td><td>@x.Codigo · @x.Articulo<small>@x.UnidadMedida</small></td><td>@x.CantidadExtraida.ToString("N3") extraído<small>@x.CantidadRechazada.ToString("N3") rechazado · @x.CantidadAprovechable.ToString("N3") aprovechable</small></td><td>@x.DestinoTipo<small>@x.DestinoDescripcion</small></td><td><span class="status-pill">@x.Estado</span></td><td><a class="text-link" href="/gestion/extracciones/@x.ExtraccionJornadaId">Ver</a></td></tr>}</tbody></table></div>
<div class="section-heading compact"><span class="eyebrow">Nueva jornada</span><h2>Registrar producción extraída.</h2></div><form method="post" action="/gestion/extracciones/crear" class="entity-form">@Html.AntiForgeryToken()<fieldset><legend>Operación</legend><div class="form-grid"><div><label>Planta</label><select name="SedeId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Material</label><select name="InventarioArticuloId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.Articulos){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Fecha</label><input name="FechaOperacion" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required/></div><div><label>Turno</label><input name="Turno" maxlength="30" placeholder="Diurno" required/></div><div><label>Frente de extracción</label><input name="FrenteExtraccion" maxlength="120" required/></div><div><label>Cantidad extraída</label><input name="CantidadExtraida" type="number" min="0.001" step="0.001" required/></div><div><label>Cantidad rechazada</label><input name="CantidadRechazada" type="number" min="0" step="0.001" value="0" required/></div></div></fieldset><fieldset><legend>Destino</legend><div class="form-grid"><div><label>Tipo</label><select name="DestinoTipo" required><option>Inventario</option><option>Procesamiento</option><option>Transporte</option><option>Tercero</option></select></div><div><label>Descripción</label><input name="DestinoDescripcion" maxlength="200"/></div><div><label>Observación</label><textarea name="Observacion" maxlength="500" rows="3"></textarea></div></div><button class="button">Registrar jornada</button></fieldset></form>
</div></section>
