@model ExtraccionDetalleModel
@{ViewData["Title"]=$"Extracción #{Model.ExtraccionJornadaId}";}
<section class="dashboard-page"><div class="container narrow"><div class="page-heading"><div><a class="back-link" href="/gestion/extracciones">← Extracción</a><span class="eyebrow">Jornada #@Model.ExtraccionJornadaId</span><h1>@Model.Articulo</h1><p>@Model.Sede · @Model.FechaOperacion.ToString("dd/MM/yyyy") · @Model.Turno</p></div><span class="status-pill">@Model.Estado</span></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<div class="scope-grid"><div class="info-panel"><span class="eyebrow">Balance</span><p><strong>@Model.CantidadAprovechable.ToString("N3") @Model.UnidadMedida aprovechable</strong></p><small>@Model.CantidadExtraida.ToString("N3") extraído · @Model.CantidadRechazada.ToString("N3") rechazado</small></div><div class="info-panel"><span class="eyebrow">Destino</span><p><strong>@Model.DestinoTipo</strong></p><small>@Model.DestinoDescripcion</small></div><div class="info-panel"><span class="eyebrow">Frente y responsable</span><p><strong>@Model.FrenteExtraccion</strong></p><small>@Model.Responsable · @Model.Observacion</small></div></div>
@if(Model.Estado is "Registrada" or "Confirmada"){<form method="post" action="/gestion/extracciones/@Model.ExtraccionJornadaId/estado" class="entity-form"><fieldset><legend>Actualizar estado</legend><select name="estado" required>@if(Model.Estado=="Registrada"){<option>Confirmada</option><option>Cancelada</option>}else{<option>Entregada</option>}</select><textarea name="comentario" placeholder="Comentario" rows="3"></textarea><button class="button">Aplicar</button></fieldset></form>}
<div class="section-heading compact"><span class="eyebrow">Trazabilidad</span><h2>Historial.</h2></div><div class="responsive-table"><table><thead><tr><th>Fecha</th><th>Usuario</th><th>Cambio</th><th>Comentario</th></tr></thead><tbody>@foreach(var h in Model.Historial){<tr><td>@h.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@h.NombreUsuario</td><td>@h.EstadoAnterior → @h.EstadoNuevo</td><td>@h.Comentario</td></tr>}</tbody></table></div>
@if(User.IsInRole("AdministradorGeneral")&&(Model.Estado is "Entregada" or "Cancelada")){<form method="post" action="/gestion/extracciones/@Model.ExtraccionJornadaId/eliminar"><button class="link-button danger">Eliminar jornada</button></form>}
</div></section>
