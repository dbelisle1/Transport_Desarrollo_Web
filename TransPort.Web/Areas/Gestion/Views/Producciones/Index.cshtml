@model ProduccionPaginaViewModel
@{ViewData["Title"]="Producción";}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>Producción y procesamiento</h1><p>Órdenes, consumo de materia prima, etapas, rendimiento y costos.</p></div></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<form method="get" class="filter-bar client-filter"><div><label>Estado</label><select name="estado"><option value="">Todos</option>@foreach(var e in new[]{"Planificada","EnProceso","Completada","Cancelada"}){<option selected="@(Model.Estado==e)">@e</option>}</select></div><div><label>Planta</label><select name="sedeId"><option value="">Todas</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id" selected="@(Model.SedeId==x.Id)">@x.Nombre</option>}</select></div><div><label>Desde</label><input type="date" name="fechaDesde" value="@Model.FechaDesde?.ToString("yyyy-MM-dd")"/></div><div><label>Hasta</label><input type="date" name="fechaHasta" value="@Model.FechaHasta?.ToString("yyyy-MM-dd")"/></div><button class="button button-small">Filtrar</button><a class="text-link" href="/gestion/producciones">Limpiar</a></form>
<div class="responsive-table"><table><thead><tr><th>Orden</th><th>Planta</th><th>Transformación</th><th>Plan</th><th>Etapa</th><th>Estado</th><th></th></tr></thead><tbody>@if(Model.Ordenes.Count==0){<tr><td colspan="7" class="empty">Sin órdenes.</td></tr>}@foreach(var x in Model.Ordenes){<tr><td><strong>#@x.ProduccionOrdenId</strong><small>@x.FechaPlanificada.ToString("dd/MM/yyyy") · @x.Responsable</small></td><td>@x.Sede</td><td>@x.CodigoEntrada · @x.ArticuloEntrada<small>→ @x.CodigoSalida · @x.ArticuloSalida</small></td><td>@x.CantidadEntrada.ToString("N3") @x.UnidadEntrada<small>@x.CantidadSalidaPlanificada.ToString("N3") @x.UnidadSalida esperada</small></td><td>@(x.EtapaActual??"—")</td><td><span class="status-pill">@x.Estado</span></td><td><a class="text-link" href="/gestion/producciones/@x.ProduccionOrdenId">Ver</a></td></tr>}</tbody></table></div>
<div class="section-heading compact"><span class="eyebrow">Nueva orden</span><h2>Planificar transformación.</h2></div><form method="post" action="/gestion/producciones/crear" class="entity-form"><fieldset><legend>Plan de producción</legend><div class="form-grid"><div><label>Planta</label><select name="SedeId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Materia prima</label><select name="ArticuloEntradaId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.Articulos){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Producto terminado</label><select name="ArticuloSalidaId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.Articulos){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Fecha planificada</label><input name="FechaPlanificada" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required/></div><div><label>Cantidad de entrada</label><input name="CantidadEntrada" type="number" min="0.001" step="0.001" required/></div><div><label>Salida esperada</label><input name="CantidadSalidaPlanificada" type="number" min="0.001" step="0.001" required/></div><div><label>Observación</label><textarea name="Observacion" maxlength="500" rows="3"></textarea></div></div><button class="button">Crear orden</button></fieldset></form></div></section>
