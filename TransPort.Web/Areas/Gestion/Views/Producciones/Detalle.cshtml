@model ProduccionDetalleModel
@{ViewData["Title"]=$"Producción #{Model.ProduccionOrdenId}";var activa=Model.Etapas.FirstOrDefault(x=>x.Estado=="EnProceso");}
<section class="dashboard-page"><div class="container narrow"><div class="page-heading"><div><a class="back-link" href="/gestion/producciones">← Producción</a><span class="eyebrow">Orden #@Model.ProduccionOrdenId</span><h1>@Model.ArticuloEntrada → @Model.ArticuloSalida</h1><p>@Model.Sede · @Model.FechaPlanificada.ToString("dd/MM/yyyy")</p></div><span class="status-pill">@Model.Estado</span></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<div class="scope-grid"><div class="info-panel"><span class="eyebrow">Entrada</span><p><strong>@Model.CantidadEntrada.ToString("N3") @Model.UnidadEntrada</strong></p><small>@Model.CodigoEntrada · @Model.ArticuloEntrada</small></div><div class="info-panel"><span class="eyebrow">Salida</span><p><strong>@(Model.CantidadSalidaReal?.ToString("N3")??Model.CantidadSalidaPlanificada.ToString("N3")) @Model.UnidadSalida</strong></p><small>Plan @Model.CantidadSalidaPlanificada.ToString("N3") · merma @(Model.CantidadMerma?.ToString("N3")??"—")</small></div><div class="info-panel"><span class="eyebrow">Costo</span><p><strong>@(Model.CostoUnitario?.ToString("C2")??"Pendiente")</strong></p><small>@Model.Responsable · @Model.Observacion</small></div></div>
@if(Model.Estado=="Planificada"){<form method="post" action="/gestion/producciones/@Model.ProduccionOrdenId/estado" class="entity-form">@Html.AntiForgeryToken()<fieldset><legend>Iniciar o cancelar</legend><select name="estado"><option>EnProceso</option><option>Cancelada</option></select><textarea name="comentario" rows="2" placeholder="Comentario"></textarea><button class="button">Aplicar</button></fieldset></form>}
<div class="section-heading compact"><span class="eyebrow">Proceso</span><h2>Etapas.</h2></div><div class="responsive-table"><table><thead><tr><th>#</th><th>Etapa</th><th>Estado</th><th>Fechas</th><th></th></tr></thead><tbody>@foreach(var e in Model.Etapas){<tr><td>@e.Secuencia</td><td><strong>@e.Nombre</strong><small>@e.Observacion</small></td><td><span class="status-pill">@e.Estado</span></td><td>@e.FechaInicio?.ToLocalTime().ToString("dd/MM HH:mm")<small>@e.FechaFin?.ToLocalTime().ToString("dd/MM HH:mm")</small></td><td>@if(e.Estado=="EnProceso"){<form method="post" action="/gestion/producciones/@Model.ProduccionOrdenId/etapas/@e.ProduccionEtapaId">@Html.AntiForgeryToken()<input name="observacion" placeholder="Resultado de etapa"/><button class="button button-small">Completar</button></form>}</td></tr>}</tbody></table></div>
@if(Model.Estado=="EnProceso"&&activa is null){<form method="post" action="/gestion/producciones/@Model.ProduccionOrdenId/estado" class="entity-form">@Html.AntiForgeryToken()<fieldset><legend>Cerrar producción</legend><input type="hidden" name="estado" value="Completada"/><div class="form-grid"><div><label>Salida real</label><input type="number" min="0.001" step="0.001" name="cantidadSalidaReal" required/></div><div><label>Merma</label><input type="number" min="0" step="0.001" name="cantidadMerma" required/></div><div><label>Costo unitario</label><input type="number" min="0" step="0.01" name="costoUnitario" required/></div><div><label>Comentario</label><input name="comentario"/></div></div><button class="button">Completar orden</button></fieldset></form>}
<div class="section-heading compact"><span class="eyebrow">Trazabilidad</span><h2>Historial.</h2></div><div class="responsive-table"><table><thead><tr><th>Fecha</th><th>Usuario</th><th>Cambio</th><th>Comentario</th></tr></thead><tbody>@foreach(var h in Model.Historial){<tr><td>@h.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@h.NombreUsuario</td><td>@h.EstadoAnterior → @h.EstadoNuevo</td><td>@h.Comentario</td></tr>}</tbody></table></div>
@if(User.IsInRole("AdministradorGeneral")&&(Model.Estado is "Completada" or "Cancelada")){<form method="post" action="/gestion/producciones/@Model.ProduccionOrdenId/eliminar">@Html.AntiForgeryToken()<button class="link-button danger">Eliminar orden</button></form>}</div></section>
