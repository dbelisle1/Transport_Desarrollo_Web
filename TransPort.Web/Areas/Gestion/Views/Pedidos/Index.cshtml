@model PedidoFiltroViewModel
@{ ViewData["Title"] = "Gestión comercial"; }
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Panel de gestión</a><h1>Gestión comercial</h1><p>Asigne responsables y dé seguimiento a pedidos, cotizaciones y reuniones.</p></div></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>} @if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<form method="get" class="filter-bar order-filter"><div><label>Buscar</label><input name="busqueda" value="@Model.Busqueda" /></div><div><label>Estado</label><select name="estado"><option value="">Todos</option>@foreach(var e in new[]{"Solicitado","EnRevision","Cotizado","Aprobado","EnProceso","Completado","Rechazado","Cancelado"}){<option selected="@(Model.Estado==e)">@e</option>}</select></div><div><label>Cliente</label><select name="clienteId"><option value="">Todos</option>@foreach(var x in Model.Opciones.Clientes){<option value="@x.Id" selected="@(Model.ClienteId==x.Id)">@x.Nombre</option>}</select></div><div><label>Giro</label><select name="giroId"><option value="">Todos</option>@foreach(var x in Model.Opciones.Giros){<option value="@x.Id" selected="@(Model.GiroId==x.Id)">@x.Nombre</option>}</select></div><button class="button button-small">Filtrar</button><a class="text-link" href="/gestion/pedidos">Limpiar</a></form>
<div class="responsive-table"><table><thead><tr><th>Solicitud</th><th>Cliente/giro</th><th>Responsable</th><th>Estado</th><th>Monto</th><th></th></tr></thead><tbody>@if(Model.Pedidos.Count==0){<tr><td colspan="6" class="empty">No hay pedidos para su alcance.</td></tr>}@foreach(var p in Model.Pedidos){<tr><td><strong>@p.Titulo</strong><small>@p.TipoSolicitud #@p.PedidoId</small></td><td>@p.Cliente<small>@p.Giro</small></td><td>@(p.Vendedor??"Sin asignar")</td><td><span class="status-pill">@p.Estado</span></td><td>@(p.MontoCotizado?.ToString("C2")??"—")</td><td><a class="text-link" href="/gestion/pedidos/@p.PedidoId">Gestionar</a></td></tr>}</tbody></table></div>
</div></section>
