@model PedidoDetalleViewModel
@{ ViewData["Title"]=Model.Pedido.Titulo; var p=Model.Pedido; }
<section class="dashboard-page"><div class="container narrow"><div class="page-heading"><div><a class="back-link" href="/gestion/pedidos">← Gestión comercial</a><span class="eyebrow">@p.TipoSolicitud #@p.PedidoId</span><h1>@p.Titulo</h1><p>@p.Cliente · @p.Giro</p></div><span class="status-pill">@p.Estado</span></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>} @if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<article class="info-panel"><p>@p.Descripcion</p><small>Solicitado por @p.Solicitante el @p.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small></article>
@if(p.Lineas.Count>0){<div class="responsive-table"><table><thead><tr><th>Producto o servicio</th><th>Cantidad</th><th>Base</th><th>Cotizar línea</th></tr></thead><tbody>@foreach(var l in p.Lineas){<tr><td><strong>@l.Nombre</strong><small>@l.Codigo · @l.Tipo</small></td><td>@l.Cantidad.ToString("N3") @l.UnidadMedida</td><td>@l.PrecioUnitarioBase.ToString("C2")<small>@l.SubtotalBase.ToString("C2")</small></td><td><form method="post" action="/gestion/pedidos/@p.PedidoId/lineas/@l.PedidoLineaId/cotizar" class="row-actions">@Html.AntiForgeryToken()<input name="precioUnitario" type="number" min="0" step="0.01" value="@(l.PrecioUnitarioCotizado??l.PrecioUnitarioBase)" required/><button class="button button-small">Guardar</button></form>@if(l.SubtotalCotizado.HasValue){<small>Subtotal @l.SubtotalCotizado.Value.ToString("C2")</small>}</td></tr>}</tbody></table></div>}
<form method="post" action="/gestion/pedidos/@p.PedidoId/gestion" class="entity-form">@Html.AntiForgeryToken()<input type="hidden" name="PedidoId" value="@p.PedidoId" /><fieldset><legend>Gestión del pedido</legend><div class="form-grid"><div><label>Estado</label><select name="Estado">@foreach(var e in new[]{"Solicitado","EnRevision","Cotizado","Aprobado","EnProceso","Completado","Rechazado","Cancelado"}){<option selected="@(p.Estado==e)">@e</option>}</select></div><div><label>Vendedor asignado</label><select name="VendedorUsuarioId"><option value="">Sin asignar</option>@foreach(var x in Model.Opciones.Vendedores){<option value="@x.Id" selected="@(p.VendedorUsuarioId==x.Id)">@x.Nombre</option>}</select></div><div><label>Monto cotizado</label><input name="MontoCotizado" type="number" min="0" step="0.01" value="@p.MontoCotizado" /></div><div><label>Fecha de reunión</label><input name="FechaReunionUtc" type="datetime-local" value="@(p.FechaReunionUtc?.ToString("yyyy-MM-ddTHH:mm"))" /></div><div class="full-field"><label>Enlace de reunión</label><input name="EnlaceReunion" type="url" value="@p.EnlaceReunion" /></div><div class="full-field"><label>Comentario del cambio</label><textarea name="Comentario" rows="3" maxlength="1000"></textarea></div></div><button class="button" type="submit">Guardar gestión</button></fieldset></form>
<div class="detail-grid"><form method="post" action="/gestion/pedidos/@p.PedidoId/comentar" class="entity-form">@Html.AntiForgeryToken()<fieldset><legend>Comentario</legend><textarea name="comentario" rows="4" required></textarea><button class="button button-small">Agregar</button></fieldset></form><form method="post" action="/gestion/pedidos/@p.PedidoId/documentos" class="entity-form">@Html.AntiForgeryToken()<fieldset><legend>Documento</legend><input name="nombre" placeholder="Nombre" required /><input name="tipoDocumento" placeholder="Tipo" required /><input name="url" type="url" placeholder="https://..." required /><button class="button button-small">Vincular</button></fieldset></form></div>
<div class="detail-grid"><article class="info-panel"><h2>Documentos</h2>@if(p.Documentos.Count==0){<p>Sin documentos.</p>}else{<ul class="document-list">@foreach(var d in p.Documentos){<li><a href="@d.Url" target="_blank" rel="noopener"><strong>@d.Nombre</strong><small>@d.TipoDocumento · @d.NombreUsuario</small></a></li>}</ul>}</article><section class="timeline"><h2>Historial</h2>@foreach(var h in p.Historial){<article><span></span><div><strong>@h.EstadoNuevo</strong><small>@h.Fecha.ToString("dd/MM/yyyy HH:mm") · @h.NombreUsuario</small><p>@h.Comentario</p></div></article>}</section></div>
@if(User.IsInRole("AdministradorGeneral")){<form method="post" action="/gestion/pedidos/@p.PedidoId/eliminar" data-confirm="¿Eliminar lógicamente este pedido?">@Html.AntiForgeryToken()<button class="link-button danger">Eliminar pedido</button></form>}
</div></section>
