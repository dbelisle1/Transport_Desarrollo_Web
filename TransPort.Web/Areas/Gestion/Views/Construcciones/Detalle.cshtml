@model ConstruccionDetalleModel
@{ViewData["Title"]=Model.Nombre;var o=(ConstruccionOpcionesModel)ViewBag.Opciones;}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion/construcciones">← Construcción</a><h1>@Model.Nombre</h1><p>@Model.TipoObra · @Model.Ubicacion · @Model.Sede</p></div><span class="status-pill">@Model.Estado</span></div><div class="scope-grid"><div class="info-panel"><strong>Presupuesto</strong><p>@Model.Presupuesto.ToString("C2")</p></div><div class="info-panel"><strong>Responsable</strong><p>@Model.Responsable</p></div><div class="info-panel"><strong>Cliente</strong><p>@(Model.Cliente??"Proyecto interno")</p></div></div><form method="post" action="/gestion/construcciones/@Model.ConstruccionProyectoId/estado" class="filter-bar"><select name="estado"><option>EnEjecucion</option><option>Suspendido</option><option>Completado</option><option>Cancelado</option></select><button class="button button-small">Cambiar estado</button></form><div class="responsive-table"><table><thead><tr><th>Actividad</th><th>Fechas</th><th>Avance</th><th>Costo</th><th>Registrar</th></tr></thead><tbody>@foreach(var a in Model.Actividades){<tr><td>@a.Nombre<small>@a.Responsable · @a.Estado</small></td><td>@a.FechaInicio.ToString("d") - @a.FechaFin.ToString("d")</td><td>@a.PorcentajeAvance%</td><td>@a.CostoReal.ToString("C2")</td><td><form method="post" action="/gestion/construcciones/@Model.ConstruccionProyectoId/actividades/@a.ConstruccionActividadId/avance"><input type="number" min="0" max="100" name="porcentaje" value="@a.PorcentajeAvance"/><input name="comentario" placeholder="Comentario" required/><input name="evidenciaUrl" placeholder="URL evidencia"/><button class="button button-small">Guardar</button></form></td></tr>}</tbody></table></div><div class="scope-grid"><form method="post" action="/gestion/construcciones/@Model.ConstruccionProyectoId/actividades" class="entity-form"><fieldset><legend>Nueva actividad</legend><input name="Nombre" placeholder="Actividad" required/><select name="ResponsableId">@foreach(var x in o.Usuarios){<option value="@x.Id">@x.Nombre</option>}</select><input type="date" name="FechaInicio"/><input type="date" name="FechaFin"/><input type="number" step=".01" name="Presupuesto" placeholder="Presupuesto"/><button class="button">Agregar</button></fieldset></form><form method="post" action="/gestion/construcciones/@Model.ConstruccionProyectoId/recursos" class="entity-form"><fieldset><legend>Asignar recurso</legend><select name="ActividadId"><option value="">General</option>@foreach(var x in Model.Actividades){<option value="@x.ConstruccionActividadId">@x.Nombre</option>}</select><select name="Tipo"><option>Personal</option><option>Otro</option><option>Material</option><option>Maquinaria</option></select><input name="Descripcion" placeholder="Descripción" required/><input type="number" step=".001" name="Cantidad" placeholder="Cantidad"/><input name="Unidad" value="unidad"/><input type="number" step=".01" name="CostoUnitario" placeholder="Costo unitario"/><select name="ArticuloId"><option value="">Sin artículo</option>@foreach(var x in o.Articulos){<option value="@x.Id">@x.Nombre</option>}</select><select name="MaquinariaId"><option value="">Sin maquinaria</option>@foreach(var x in o.Maquinarias){<option value="@x.Id">@x.Nombre</option>}</select><button class="button">Asignar</button></fieldset></form></div><div class="section-heading compact"><h2>Recursos y avances.</h2></div><div class="responsive-table"><table><tbody>@foreach(var r in Model.Recursos){<tr><td>@r.Tipo · @r.Descripcion</td><td>@r.Cantidad @r.Unidad</td><td>@((r.Cantidad*r.CostoUnitario).ToString("C2"))</td></tr>}@foreach(var a in Model.Avances){<tr><td>@a.Actividad · @a.PorcentajeAnterior → @a.PorcentajeNuevo%</td><td>@a.Comentario</td><td>@a.NombreUsuario</td></tr>}</tbody></table></div>@if(User.IsInRole("AdministradorGeneral")&&(Model.Estado is "Completado" or "Cancelado")){<form method="post" action="/gestion/construcciones/@Model.ConstruccionProyectoId/eliminar"><button class="link-button danger">Eliminar proyecto</button></form>}</div></section>
