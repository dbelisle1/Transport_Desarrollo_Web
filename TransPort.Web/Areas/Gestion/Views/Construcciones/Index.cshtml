@model ConstruccionPaginaViewModel
@{ViewData["Title"]="Construcción";}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>Servicios de construcción</h1><p>Puentes, carreteras, edificios, actividades, recursos y presupuesto.</p></div></div><form method="get" class="filter-bar"><input name="busqueda" value="@Model.Busqueda" placeholder="Buscar obra"/><select name="estado"><option value="">Todos</option>@foreach(var e in new[]{"Planificado","EnEjecucion","Suspendido","Completado","Cancelado"}){<option selected="@(Model.Estado==e)">@e</option>}</select><button class="button button-small">Filtrar</button></form><div class="responsive-table"><table><thead><tr><th>Proyecto</th><th>Plazo</th><th>Avance</th><th>Presupuesto / real</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in Model.Proyectos){<tr><td><strong>@p.Nombre</strong><small>@p.TipoObra · @p.Ubicacion · @p.Sede</small></td><td>@p.FechaInicioPlanificada.ToString("dd/MM/yy") - @p.FechaFinPlanificada.ToString("dd/MM/yy")</td><td>@p.PorcentajeAvance.ToString("N2")%</td><td>@p.Presupuesto.ToString("C2")<small>@p.CostoReal.ToString("C2") real</small></td><td>@p.Estado</td><td><a href="/gestion/construcciones/@p.ConstruccionProyectoId">Ver</a></td></tr>}</tbody></table></div><form method="post" action="/gestion/construcciones/crear" class="entity-form"><fieldset><legend>Nueva obra</legend><div class="form-grid"><select name="SedeId">@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id">@x.Nombre</option>}</select><select name="ClienteId"><option value="">Interna</option>@foreach(var x in Model.Opciones.Clientes){<option value="@x.Id">@x.Nombre</option>}</select><input name="Nombre" placeholder="Nombre" required/><select name="TipoObra"><option>Puente</option><option>Carretera</option><option>Edificio</option><option>Otro</option></select><input name="Ubicacion" placeholder="Ubicación" required/><input type="date" name="FechaInicio" required/><input type="date" name="FechaFin" required/><input type="number" step=".01" name="Presupuesto" placeholder="Presupuesto"/><select name="ResponsableId">@foreach(var x in Model.Opciones.Usuarios){<option value="@x.Id">@x.Nombre</option>}</select></div><button class="button">Crear proyecto</button></fieldset></form></div></section>
