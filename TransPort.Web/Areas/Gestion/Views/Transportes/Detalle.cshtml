@model TransporteViajeDetalleModel
@{ViewData["Title"]=$"Viaje #{Model.TransporteViajeId}";}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion/transportes">← Transporte</a><h1>@Model.Origen → @Model.Destino</h1><p>@Model.Placa · @Model.Conductor · @Model.DescripcionCarga</p></div><span class="status-pill">@Model.Estado</span></div><div class="scope-grid"><div class="info-panel"><strong>@Model.Tipo</strong><p>@Model.PesoCarga.ToString("N3")</p></div><div class="info-panel"><strong>Salida</strong><p>@Model.FechaSalidaPlanificada.ToString("g")</p></div><div class="info-panel"><strong>Cliente</strong><p>@(Model.Cliente??"Operación interna")</p></div></div>@if(Model.Estado is "Programado" or "EnRuta"){<form method="post" action="/gestion/transportes/@Model.TransporteViajeId/estado" class="entity-form"><select name="estado">@if(Model.Estado=="Programado"){<option>EnRuta</option>}else{<option>Entregado</option>}<option>Cancelado</option></select><input name="observacion" placeholder="Observación"/><button class="button">Actualizar</button></form>}<form method="post" action="/gestion/transportes/@Model.TransporteViajeId/incidencias" class="entity-form"><fieldset><legend>Nueva incidencia</legend><input name="tipo" placeholder="Tipo" required/><select name="severidad"><option>Baja</option><option>Media</option><option>Alta</option><option>Critica</option></select><input name="descripcion" placeholder="Descripción" required/><button class="button">Registrar</button></fieldset></form><div class="responsive-table"><table><thead><tr><th>Incidencia</th><th>Severidad</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var i in Model.Incidencias){<tr><td>@i.Tipo<small>@i.Descripcion · @i.Fecha.ToLocalTime().ToString("g")</small></td><td>@i.Severidad</td><td>@(i.Resuelta?"Resuelta":"Abierta")<small>@i.Resolucion</small></td><td>@if(!i.Resuelta){<form method="post" action="/gestion/transportes/@Model.TransporteViajeId/incidencias/@i.TransporteIncidenciaId"><input name="resolucion" required/><button class="button button-small">Resolver</button></form>}</td></tr>}</tbody></table></div>@if(User.IsInRole("AdministradorGeneral")&&(Model.Estado is "Entregado" or "Cancelado")){<form method="post" action="/gestion/transportes/@Model.TransporteViajeId/eliminar"><button class="link-button danger">Eliminar viaje</button></form>}</div></section>
