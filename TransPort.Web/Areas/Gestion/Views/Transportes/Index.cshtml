@model TransportePaginaViewModel
@{ViewData["Title"]="Transporte";}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>Transporte y logística</h1><p>Flota, conductores, cargas, rutas y entregas nacionales o internacionales.</p></div></div><form method="get" class="filter-bar"><select name="estado"><option value="">Todos los estados</option>@foreach(var x in new[]{"Programado","EnRuta","Entregado","Cancelado"}){<option selected="@(Model.Estado==x)">@x</option>}</select><select name="tipo"><option value="">Todos los tipos</option>@foreach(var x in new[]{"MateriaPrima","Nacional","Internacional"}){<option selected="@(Model.Tipo==x)">@x</option>}</select><button class="button button-small">Filtrar</button></form><div class="responsive-table"><table><thead><tr><th>Viaje</th><th>Ruta/carga</th><th>Unidad</th><th>Salida</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model.Viajes){<tr><td><strong>#@x.TransporteViajeId · @x.Tipo</strong><small>@x.Sede · @x.Cliente</small></td><td>@x.Origen → @x.Destino<small>@x.DescripcionCarga · @x.PesoCarga.ToString("N3")</small></td><td>@x.Placa<small>@x.Conductor</small></td><td>@x.FechaSalidaPlanificada.ToString("dd/MM/yyyy HH:mm")</td><td>@x.Estado<small>@x.IncidenciasAbiertas incidencia(s)</small></td><td><a href="/gestion/transportes/@x.TransporteViajeId">Ver</a></td></tr>}</tbody></table></div><div class="scope-grid"><form method="post" action="/gestion/transportes/vehiculos" class="entity-form"><fieldset><legend>Nuevo vehículo</legend><select name="SedeId">@foreach(var s in Model.Opciones.Sedes){<option value="@s.Id">@s.Nombre</option>}</select><input name="Placa" placeholder="Placa" required/><input name="Tipo" placeholder="Camión" required/><input name="Marca" placeholder="Marca" required/><input name="Modelo" placeholder="Modelo" required/><input type="number" step=".001" name="Capacidad" placeholder="Capacidad" required/><input name="UnidadCapacidad" value="t"/><label><input type="checkbox" name="EsInternacional" value="true"/> Internacional</label><button class="button">Crear</button></fieldset></form><form method="post" action="/gestion/transportes/conductores" class="entity-form"><fieldset><legend>Nuevo conductor</legend><input name="Nombre" placeholder="Nombre" required/><input name="Licencia" placeholder="Licencia" required/><input name="Categoria" placeholder="Categoría" required/><input type="date" name="FechaVencimiento" required/><input name="Telefono" placeholder="Teléfono"/><button class="button">Crear</button></fieldset></form></div><form method="post" action="/gestion/transportes/viajes" class="entity-form"><fieldset><legend>Programar viaje</legend><div class="form-grid"><select name="SedeId">@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id">@x.Nombre</option>}</select><select name="VehiculoId">@foreach(var x in Model.Opciones.Vehiculos){<option value="@x.Id">@x.Nombre</option>}</select><select name="ConductorId">@foreach(var x in Model.Opciones.Conductores){<option value="@x.Id">@x.Nombre</option>}</select><select name="ClienteId"><option value="">Sin cliente</option>@foreach(var x in Model.Opciones.Clientes){<option value="@x.Id">@x.Nombre</option>}</select><select name="Tipo"><option>MateriaPrima</option><option>Nacional</option><option>Internacional</option></select><input name="Origen" placeholder="Origen / puerto / bodega" required/><input name="Destino" placeholder="Destino / frontera / bodega" required/><input name="DescripcionCarga" placeholder="Carga" required/><input type="number" step=".001" name="PesoCarga" placeholder="Peso"/><input type="datetime-local" name="FechaSalidaPlanificada" required/></div><button class="button">Programar viaje</button></fieldset></form></div></section>
