@model AbastecimientoDetalleModel
@{ViewData["Title"]=$"Abastecimiento #{Model.AbastecimientoSolicitudId}";}
<section class="dashboard-page"><div class="container narrow"><div class="page-heading"><div><a class="back-link" href="/gestion/abastecimientos">← Abastecimiento</a><span class="eyebrow">Solicitud #@Model.AbastecimientoSolicitudId</span><h1>@Model.Motivo</h1><p>@Model.GiroSolicitante / @Model.SedeSolicitante → @Model.GiroProveedor / @Model.SedeProveedor</p></div><span class="status-pill">@Model.Estado</span></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<article class="info-panel"><strong>Necesario: @Model.FechaNecesaria.ToString("dd/MM/yyyy")</strong><p>Solicitante: @Model.Solicitante</p><div class="responsive-table"><table><thead><tr><th>Proveedor</th><th>Destino</th><th>Cantidad</th></tr></thead><tbody>@foreach(var x in Model.Detalles){<tr><td>@x.CodigoProveedor · @x.ArticuloProveedor</td><td>@x.CodigoDestino · @x.ArticuloDestino</td><td>@x.Cantidad.ToString("N3") @x.UnidadMedida</td></tr>}</tbody></table></div></article>
<form method="post" action="/gestion/abastecimientos/@Model.AbastecimientoSolicitudId/estado" class="entity-form"><fieldset><legend>Actualizar estado</legend><select name="estado" required><option>Aprobado</option><option>Preparacion</option><option>Despachado</option><option>Recibido</option><option>Rechazado</option><option>Cancelado</option></select><textarea name="comentario" placeholder="Comentario" rows="3"></textarea><button class="button">Aplicar</button></fieldset></form>
<form method="post" action="/gestion/abastecimientos/@Model.AbastecimientoSolicitudId/comentar" class="entity-form"><fieldset><legend>Agregar comentario</legend><textarea name="comentario" required rows="3"></textarea><button class="button button-small">Comentar</button></fieldset></form>
<section class="timeline"><h2>Historial</h2>@foreach(var h in Model.Historial){<article><span></span><div><strong>@h.EstadoNuevo</strong><small>@h.Fecha.ToString("dd/MM/yyyy HH:mm") · @h.NombreUsuario</small><p>@h.Comentario</p></div></article>}</section>
@if(User.IsInRole("AdministradorGeneral")){<form method="post" action="/gestion/abastecimientos/@Model.AbastecimientoSolicitudId/eliminar"><button class="link-button danger">Eliminar solicitud</button></form>}
</div></section>
