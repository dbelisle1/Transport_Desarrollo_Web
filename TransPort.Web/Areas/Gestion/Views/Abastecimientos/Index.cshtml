@model AbastecimientoPaginaViewModel
@{ViewData["Title"]="Abastecimiento";}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>Abastecimiento entre giros</h1><p>Solicitudes programadas con reserva y trazabilidad de inventario.</p></div></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<form method="get" class="filter-bar client-filter"><div><label>Buscar</label><input name="busqueda" value="@Model.Busqueda"/></div><div><label>Estado</label><select name="estado"><option value="">Todos</option>@foreach(var e in new[]{"Solicitado","Aprobado","Preparacion","Despachado","Recibido","Rechazado","Cancelado"}){<option selected="@(Model.Estado==e)">@e</option>}</select></div><button class="button button-small">Filtrar</button><a class="text-link" href="/gestion/abastecimientos">Limpiar</a></form>
<div class="responsive-table"><table><thead><tr><th>Solicitud</th><th>Origen</th><th>Proveedor</th><th>Necesaria</th><th>Estado</th><th></th></tr></thead><tbody>@if(Model.Solicitudes.Count==0){<tr><td colspan="6" class="empty">Sin solicitudes.</td></tr>}@foreach(var x in Model.Solicitudes){<tr><td><strong>#@x.AbastecimientoSolicitudId · @x.Motivo</strong><small>@x.Lineas línea(s) · @x.Solicitante</small></td><td>@x.GiroSolicitante<small>@x.SedeSolicitante</small></td><td>@x.GiroProveedor<small>@x.SedeProveedor</small></td><td>@x.FechaNecesaria.ToString("dd/MM/yyyy")</td><td><span class="status-pill">@x.Estado</span></td><td><a class="text-link" href="/gestion/abastecimientos/@x.AbastecimientoSolicitudId">Ver</a></td></tr>}</tbody></table></div>
<div class="section-heading compact"><span class="eyebrow">Nueva solicitud</span><h2>Programar abastecimiento.</h2></div><form method="post" action="/gestion/abastecimientos/crear" class="entity-form"><fieldset><legend>Ruta interna</legend><div class="form-grid"><div><label>Giro solicitante</label><select name="GiroSolicitanteId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.GirosSolicitante){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Sede solicitante</label><select name="SedeSolicitanteId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.SedesSolicitante){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Giro proveedor</label><select name="GiroProveedorId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.GirosProveedor){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Sede proveedora</label><select name="SedeProveedorId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.SedesProveedor){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Fecha necesaria</label><input name="FechaNecesaria" type="date" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required/></div><div><label>Motivo</label><input name="Motivo" required maxlength="500"/></div></div></fieldset><fieldset><legend>Artículo solicitado</legend><div class="form-grid"><div><label>Artículo del proveedor</label><select name="ArticuloProveedorId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.Articulos){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Artículo equivalente en destino</label><select name="ArticuloDestinoId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.Articulos){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Cantidad</label><input name="Cantidad" type="number" min="0.001" step="0.001" required/></div></div><button class="button">Crear solicitud</button></fieldset></form>
</div></section>
