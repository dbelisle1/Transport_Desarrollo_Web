@model OfertaCatalogoEditarViewModel
@{ ViewData["Title"]="Editar oferta"; }
<section class="dashboard-page"><div class="container narrow"><div class="page-heading"><div><a class="back-link" href="/gestion/catalogo">← Catálogo comercial</a><h1>Editar oferta</h1><p>Los pedidos existentes conservan los datos que tenía la oferta al solicitarlos.</p></div></div>
<form method="post" class="entity-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="CatalogoOfertaId" type="hidden"/><fieldset><legend>Datos comerciales</legend><div class="form-grid"><div><label asp-for="GiroNegocioId"></label><select asp-for="GiroNegocioId">@foreach(var x in Model.Opciones.Giros){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label asp-for="Codigo"></label><input asp-for="Codigo"/></div><div><label asp-for="Tipo"></label><select asp-for="Tipo"><option>Producto</option><option>Servicio</option></select></div><div><label asp-for="Nombre"></label><input asp-for="Nombre"/></div><div><label asp-for="UnidadMedida"></label><input asp-for="UnidadMedida"/></div><div><label asp-for="PrecioBase"></label><input asp-for="PrecioBase" type="number" min="0" step="0.01"/></div><div class="full-field"><label asp-for="Descripcion"></label><textarea asp-for="Descripcion"></textarea></div><label class="check-line"><input asp-for="EsPublico"/> @Html.DisplayNameFor(x=>x.EsPublico)</label><label class="check-line"><input asp-for="EsActivo"/> @Html.DisplayNameFor(x=>x.EsActivo)</label></div><button class="button">Guardar cambios</button></fieldset></form>
</div></section>
