@model CatalogoComercialPaginaViewModel
@{ ViewData["Title"]="Catálogo comercial"; }
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>Catálogo comercial</h1><p>Productos y servicios publicados en la sala de ventas y disponibles para pedidos.</p></div><a class="text-link" href="/catalogo" target="_blank">Ver catálogo público ↗</a></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<form method="get" class="filter-bar"><input name="busqueda" value="@Model.Busqueda" placeholder="Código, nombre o descripción"/><select name="giroId"><option value="">Todos los giros</option>@foreach(var x in Model.Opciones.Giros){<option value="@x.Id" selected="@(Model.GiroId==x.Id)">@x.Nombre</option>}</select><select name="tipo"><option value="">Todos los tipos</option><option selected="@(Model.Tipo=="Producto")">Producto</option><option selected="@(Model.Tipo=="Servicio")">Servicio</option></select><select name="esActivo"><option value="">Todos</option><option value="true" selected="@(Model.EsActivo==true)">Activos</option><option value="false" selected="@(Model.EsActivo==false)">Inactivos</option></select><button class="button button-small">Filtrar</button></form>
<div class="responsive-table"><table><thead><tr><th>Oferta</th><th>Giro</th><th>Precio base</th><th>Publicación</th><th></th></tr></thead><tbody>@foreach(var x in Model.Ofertas){<tr><td><strong>@x.Nombre</strong><small>@x.Codigo · @x.Tipo · @x.UnidadMedida</small></td><td>@x.Giro</td><td>@x.PrecioBase.ToString("C2")</td><td>@(x.EsActivo?"Activa":"Inactiva") · @(x.EsPublico?"Pública":"Interna")</td><td><div class="row-actions"><a href="/gestion/catalogo/@x.CatalogoOfertaId/editar">Editar</a><form method="post" action="/gestion/catalogo/@x.CatalogoOfertaId/eliminar" data-confirm="¿Eliminar lógicamente esta oferta?">@Html.AntiForgeryToken()<button class="link-button danger">Eliminar</button></form></div></td></tr>}</tbody></table></div>
<form method="post" action="/gestion/catalogo/crear" class="entity-form">@Html.AntiForgeryToken()<fieldset><legend>Nueva oferta</legend><div class="form-grid"><div><label>Giro</label><select name="GiroNegocioId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.Giros){<option value="@x.Id">@x.Nombre</option>}</select></div><div><label>Código</label><input name="Codigo" maxlength="50" required/></div><div><label>Tipo</label><select name="Tipo"><option>Producto</option><option>Servicio</option></select></div><div><label>Nombre</label><input name="Nombre" maxlength="180" required/></div><div><label>Unidad de medida</label><input name="UnidadMedida" placeholder="Unidad, tonelada, viaje, día…" maxlength="40" required/></div><div><label>Precio base</label><input name="PrecioBase" type="number" min="0" step="0.01" required/></div><div class="full-field"><label>Descripción</label><textarea name="Descripcion" maxlength="1000" required></textarea></div><input type="hidden" name="EsPublico" value="false"/><label class="check-line"><input type="checkbox" name="EsPublico" value="true" checked/> Visible al público</label><input type="hidden" name="EsActivo" value="false"/><label class="check-line"><input type="checkbox" name="EsActivo" value="true" checked/> Oferta activa</label></div><button class="button">Crear oferta</button></fieldset></form>
</div></section>
