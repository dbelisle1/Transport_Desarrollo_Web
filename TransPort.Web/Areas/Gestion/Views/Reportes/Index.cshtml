@model ReporteInternoPaginaViewModel
@{ViewData["Title"]="Reportes consolidados";var r=Model.Reporte;}
<section class="dashboard-page"><div class="container">
<div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>Reportes operativos y financieros</h1><p>Indicadores derivados de las operaciones y transacciones dentro de su alcance.</p></div></div>
<form method="get" class="filter-bar"><input type="date" name="desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" required/><input type="date" name="hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" required/><select name="giroId"><option value="">Todos los giros autorizados</option>@foreach(var x in Model.Opciones.Giros){<option value="@x.Id" selected="@(Model.GiroId==x.Id)">@x.Nombre</option>}</select><select name="sedeId"><option value="">Todas las sedes autorizadas</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id" selected="@(Model.SedeId==x.Id)">@x.Nombre</option>}</select><button class="button button-small">Generar</button></form>
<div class="stats-grid"><article><span>Ingresos</span><strong>@r.Resumen.Ingresos.ToString("C2")</strong><small>Transacciones registradas</small></article><article><span>Gastos</span><strong>@r.Resumen.Gastos.ToString("C2")</strong><small>Gasto real del período</small></article><article><span>Resultado</span><strong>@r.Resumen.Resultado.ToString("C2")</strong><small>Ingresos menos gastos</small></article><article><span>Operaciones</span><strong>@r.Resumen.Operaciones</strong><small>@r.Resumen.Completadas completadas</small></article></div>
<div class="section-heading compact"><span class="eyebrow">Por giro</span><h2>Desempeño operativo y financiero.</h2></div><div class="responsive-table"><table><thead><tr><th>Giro</th><th>Operaciones</th><th>Indicador principal</th><th>Presupuesto</th><th>Gastos</th><th>Ingresos</th><th>Resultado</th></tr></thead><tbody>@if(r.Giros.Count==0){<tr><td colspan="7" class="empty">No hay giros autorizados para este reporte.</td></tr>}@foreach(var x in r.Giros){<tr><td><strong>@x.Giro</strong></td><td>@x.Operaciones<small>@x.Completadas completadas</small></td><td>@x.ValorIndicador.ToString("N2") @x.UnidadIndicador<small>@x.Indicador</small></td><td>@x.Presupuesto.ToString("C2")</td><td>@x.Gastos.ToString("C2")</td><td>@x.Ingresos.ToString("C2")</td><td><strong>@x.Resultado.ToString("C2")</strong></td></tr>}</tbody></table></div>
<div class="section-heading compact"><span class="eyebrow">Evolución</span><h2>Resumen mensual.</h2></div><div class="responsive-table"><table><thead><tr><th>Período</th><th>Presupuesto</th><th>Gastos</th><th>Ingresos</th><th>Resultado</th></tr></thead><tbody>@foreach(var x in r.Periodos){<tr><td>@x.Periodo</td><td>@x.Presupuesto.ToString("C2")</td><td>@x.Gastos.ToString("C2")</td><td>@x.Ingresos.ToString("C2")</td><td><strong>@x.Resultado.ToString("C2")</strong></td></tr>}</tbody></table></div>
</div></section>
