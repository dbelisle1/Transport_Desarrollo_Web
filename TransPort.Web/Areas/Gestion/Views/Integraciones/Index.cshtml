@model IntegracionPaginaViewModel
@{ViewData["Title"]="Integraciones externas";}
<section class="dashboard-page"><div class="container">
<div class="dashboard-hero"><div><span class="eyebrow">Simulador controlado</span><h1>Integraciones externas</h1><p>Pruebe entradas REST, Webhook o CSV sin depender de servicios de terceros.</p></div><a class="button secondary" href="/gestion">Volver al panel</a></div>
<div class="info-panel"><strong>Entorno simulado:</strong> estos formularios no se conectan con proveedores reales. El contenido original, canal, socio, intentos y resultado quedan trazados.</div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<section class="info-panel"><span class="eyebrow">Fuente externa</span><h2>Simular recepción o intercambio</h2><form method="post" action="/gestion/integraciones/simular" class="form-grid">@Html.AntiForgeryToken()
<label>Canal<select name="Canal"><option>Webhook</option><option>REST</option><option>CSV</option></select></label><label>Dirección<select name="Direccion"><option>Entrada</option><option>Salida</option></select></label><label>Tipo de socio<select name="SocioTipo"><option>Proveedor</option><option>Cliente</option><option>Socio</option></select></label><label>Nombre del socio<input name="SocioNombre" value="@Model.Nueva.SocioNombre" required maxlength="180" /></label>
<label>Operación<select name="Operacion"><option>RecepcionMateriaPrima</option><option>EstadoPedido</option><option>Notificacion</option><option>IntercambioDatos</option></select></label><label>Clave de idempotencia<input name="ClaveIdempotencia" value="@Model.Nueva.ClaveIdempotencia" required maxlength="120" /></label><label>Documento externo<input name="DocumentoExterno" value="@Model.Nueva.DocumentoExterno" maxlength="120" /></label>
<label>Artículo destino<select name="InventarioArticuloId"><option value="">No aplica</option>@foreach(var x in Model.Opciones.Articulos){<option value="@x.Id" selected="@(Model.Nueva.InventarioArticuloId==x.Id)">@x.Nombre</option>}</select></label><label>Sede destino<select name="SedeId"><option value="">No aplica</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id" selected="@(Model.Nueva.SedeId==x.Id)">@x.Nombre</option>}</select></label><label>Cantidad<input name="Cantidad" type="number" min="0.001" step="0.001" value="@Model.Nueva.Cantidad" /></label>
<label class="full-width">Contenido original JSON o CSV<textarea name="Contenido" required maxlength="4000" rows="7">@Model.Nueva.Contenido</textarea><small>El ejemplo precargado representa 25.5 t recibidas en el área de Ciudad de Guatemala.</small></label><div class="full-width"><button class="button" type="submit">Procesar dato simulado</button></div>
</form></section>
<section class="info-panel"><span class="eyebrow">Trazabilidad</span><h2>Eventos recibidos</h2><form method="get" class="filter-bar"><select name="estado"><option value="">Todos los estados</option><option selected="@(Model.Estado=="Procesado")">Procesado</option><option selected="@(Model.Estado=="Error")">Error</option><option selected="@(Model.Estado=="Recibido")">Recibido</option></select><select name="canal"><option value="">Todos los canales</option><option selected="@(Model.Canal=="REST")">REST</option><option selected="@(Model.Canal=="Webhook")">Webhook</option><option selected="@(Model.Canal=="CSV")">CSV</option></select><input name="busqueda" value="@Model.Busqueda" placeholder="Socio, documento o idempotencia"/><button class="button secondary" type="submit">Filtrar</button></form>
<div class="responsive-table"><table><thead><tr><th>Evento</th><th>Socio / operación</th><th>Inventario</th><th>Estado</th><th>Fecha</th><th></th></tr></thead><tbody>@if(Model.Eventos.Count==0){<tr><td colspan="6" class="empty">No hay eventos externos registrados.</td></tr>}@foreach(var x in Model.Eventos){<tr><td><strong>#@x.IntegracionEventoId · @x.Canal</strong><small>@x.ClaveIdempotencia · @x.Direccion</small></td><td>@x.SocioNombre<small>@x.SocioTipo · @x.Operacion</small></td><td>@(x.ArticuloCodigo??"No aplica")<small>@(x.Sede??"Sin sede") @if(x.Cantidad is not null){<text> · @x.Cantidad</text>}</small></td><td><span class="status-pill">@x.Estado</span><small>@x.Intentos intento(s)</small></td><td>@x.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td><td><a class="text-link" href="/gestion/integraciones/@x.IntegracionEventoId">Ver</a></td></tr>}</tbody></table></div></section>
</div></section>
