@model IntegracionDetalleModel
@{ViewData["Title"]=$"Integración #{Model.IntegracionEventoId}";}
<section class="dashboard-page"><div class="container"><div class="dashboard-hero"><div><span class="eyebrow">@Model.Canal · @Model.Direccion</span><h1>Integración #@Model.IntegracionEventoId</h1><p>@Model.SocioTipo: @Model.SocioNombre · @Model.Operacion</p></div><div><span class="status-pill">@Model.Estado</span> <a class="button secondary" href="/gestion/integraciones">Volver</a></div></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<div class="content-grid"><section class="info-panel"><span class="eyebrow">Contenido fuente simulado</span><h2>Datos originales</h2><pre>@Model.Contenido</pre><p><strong>Idempotencia:</strong> @Model.ClaveIdempotencia<br/><strong>Documento:</strong> @(Model.DocumentoExterno??"No indicado")<br/><strong>Registrado por:</strong> @Model.NombreUsuario<br/><strong>Intentos:</strong> @Model.Intentos</p>@if(Model.Error is not null){<div class="alert error">@Model.Error</div>}</section><aside class="info-panel"><span class="eyebrow">Resultado</span><h2>Procesamiento</h2><p><strong>Artículo:</strong> @(Model.Articulo??"No aplica")<br/><strong>Sede:</strong> @(Model.Sede??"No aplica")<br/><strong>Cantidad:</strong> @(Model.Cantidad?.ToString("N3")??"No aplica") @(Model.UnidadMedida??"")<br/><strong>Movimiento:</strong> @(Model.InventarioMovimientoId?.ToString()??"No generado")<br/><strong>Procesado:</strong> @(Model.FechaProcesamiento?.ToString("dd/MM/yyyy HH:mm")??"Pendiente")</p>@if(Model.Estado=="Error"){<form method="post" action="/gestion/integraciones/@Model.IntegracionEventoId/reintentar">@Html.AntiForgeryToken()<button class="button" type="submit">Reintentar procesamiento</button></form>}@if(User.IsInRole("AdministradorGeneral")){<form method="post" action="/gestion/integraciones/@Model.IntegracionEventoId/eliminar">@Html.AntiForgeryToken()<button class="button danger" type="submit">Eliminar evento</button></form>}</aside></div>
</div></section>
