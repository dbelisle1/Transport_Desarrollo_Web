@model FinanzaPaginaViewModel
@{ViewData["Title"]="Presupuestos";var ahora=DateTime.Today;}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>Presupuestos y gastos</h1><p>Control mensual independiente por giro y sede.</p></div></div>
<form method="get" class="filter-bar"><input type="number" name="anio" value="@Model.Anio" placeholder="Año"/><input type="number" min="1" max="12" name="mes" value="@Model.Mes" placeholder="Mes"/><select name="giroId"><option value="">Todos los giros</option>@foreach(var x in Model.Opciones.Giros){<option value="@x.Id" selected="@(Model.GiroId==x.Id)">@x.Nombre</option>}</select><select name="sedeId"><option value="">Todas las sedes</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id" selected="@(Model.SedeId==x.Id)">@x.Nombre</option>}</select><button class="button button-small">Filtrar</button></form>
<div class="responsive-table"><table><thead><tr><th>Presupuesto</th><th>Período</th><th>Asignado</th><th>Real</th><th>Disponible</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in Model.Presupuestos){<tr><td><strong>@p.Nombre</strong><small>@p.Giro · @p.Sede</small></td><td>@p.Mes.ToString("00")/@p.Anio</td><td>@p.Monto.ToString("C2")</td><td>@p.GastoReal.ToString("C2")<small>@p.PorcentajeEjecutado.ToString("N2")%</small></td><td>@p.Disponible.ToString("C2")</td><td>@p.Estado</td><td><a href="/gestion/finanzas/@p.FinanzaPresupuestoId">Ver</a></td></tr>}</tbody></table></div>
@if(User.IsInRole("AdministradorGeneral")||User.IsInRole("Gerente")){<form method="post" action="/gestion/finanzas/crear" class="entity-form"><fieldset><legend>Nuevo presupuesto</legend><div class="form-grid"><select name="GiroId">@foreach(var x in Model.Opciones.Giros){<option value="@x.Id">@x.Nombre</option>}</select><select name="SedeId">@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id">@x.Nombre</option>}</select><input type="number" name="Anio" value="@ahora.Year" min="2000" max="2100"/><input type="number" name="Mes" value="@ahora.Month" min="1" max="12"/><input name="Nombre" placeholder="Nombre del presupuesto" required/><input type="number" step=".01" min=".01" name="Monto" placeholder="Monto" required/><input name="Observacion" placeholder="Observación"/></div><button class="button">Crear presupuesto</button></fieldset></form>}</div></section>
