@model PresupuestoDetalleModel
@{ViewData["Title"]=Model.Nombre;}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion/finanzas">← Presupuestos</a><h1>@Model.Nombre</h1><p>@Model.Giro · @Model.Sede · @Model.Mes.ToString("00")/@Model.Anio</p></div><span class="status-pill">@Model.Estado</span></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<div class="scope-grid"><div class="info-panel"><strong>Asignado</strong><p>@Model.Monto.ToString("C2")</p></div><div class="info-panel"><strong>Gasto real</strong><p>@Model.GastoReal.ToString("C2")</p></div><div class="info-panel"><strong>Disponible</strong><p>@Model.Disponible.ToString("C2") · @Model.PorcentajeEjecutado.ToString("N2")%</p></div></div>
@if(Model.Estado=="Abierto"){<form method="post" action="/gestion/finanzas/@Model.FinanzaPresupuestoId/gastos" class="entity-form">@Html.AntiForgeryToken()<fieldset><legend>Registrar gasto</legend><div class="form-grid"><input type="date" name="Fecha" value="@DateTime.Today.ToString("yyyy-MM-dd")" required/><select name="Categoria"><option>Material</option><option>Personal</option><option>Transporte</option><option>Servicios</option><option>Maquinaria</option><option>Otro</option></select><input name="Concepto" placeholder="Concepto" required/><input type="number" step=".01" min=".01" name="Monto" placeholder="Monto" required/><select name="OrigenModulo"><option>Manual</option><option>Pedido</option><option>Produccion</option><option>Transporte</option><option>Construccion</option></select><input type="number" name="OrigenRegistroId" placeholder="ID del registro de origen"/><input name="Referencia" placeholder="Factura o referencia"/></div><small>Para un gasto manual deje vacío el ID. Para los demás orígenes use el ID del pedido, orden, viaje u obra.</small><button class="button">Registrar gasto</button></fieldset></form>}
<div class="responsive-table"><table><thead><tr><th>Fecha</th><th>Gasto</th><th>Origen</th><th>Monto</th><th>Usuario</th></tr></thead><tbody>@foreach(var x in Model.Gastos){<tr><td>@x.Fecha.ToString("dd/MM/yyyy")</td><td><strong>@x.Concepto</strong><small>@x.Categoria · @x.Referencia</small></td><td>@x.OrigenModulo @x.OrigenRegistroId</td><td>@x.Monto.ToString("C2")</td><td>@x.NombreUsuario</td></tr>}</tbody></table></div>
@if(Model.Estado=="Abierto"&&(User.IsInRole("AdministradorGeneral")||User.IsInRole("Gerente"))){<form method="post" action="/gestion/finanzas/@Model.FinanzaPresupuestoId/estado" class="filter-bar">@Html.AntiForgeryToken()<button class="button button-small" name="estado" value="Cerrado">Cerrar presupuesto</button><button class="button button-small" name="estado" value="Cancelado">Cancelar</button></form>}@if(User.IsInRole("AdministradorGeneral")&&Model.Estado!="Abierto"){<form method="post" action="/gestion/finanzas/@Model.FinanzaPresupuestoId/eliminar">@Html.AntiForgeryToken()<button class="link-button danger">Eliminar presupuesto</button></form>}</div></section>
