@model InventarioPaginaViewModel
@{ViewData["Title"]="Inventarios y bodegas";}
<section class="dashboard-page"><div class="container">
<div class="page-heading"><div><a class="back-link" href="/gestion">← Panel de gestión</a><h1>Inventarios y bodegas</h1><p>Existencias, reservas y movimientos por giro y sede autorizados.</p></div></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<form method="get" class="filter-bar inventory-filter"><div><label>Buscar</label><input name="busqueda" value="@Model.Busqueda" placeholder="Código, nombre o categoría"/></div><div><label>Giro</label><select name="giroId"><option value="">Todos</option>@foreach(var x in Model.Opciones.Giros){<option value="@x.Id" selected="@(Model.GiroId==x.Id)">@x.Nombre</option>}</select></div><div><label>Sede</label><select name="sedeId"><option value="">Todas</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id" selected="@(Model.SedeId==x.Id)">@x.Nombre</option>}</select></div><label class="check-line"><input type="checkbox" name="soloBajoMinimo" value="true" checked="@Model.SoloBajoMinimo"/><span>Bajo mínimo</span></label><button class="button button-small">Filtrar</button><a class="text-link" href="/gestion/inventarios">Limpiar</a></form>
<div class="responsive-table"><table><thead><tr><th>Artículo</th><th>Giro / sede</th><th>Total</th><th>Reservado</th><th>Disponible</th><th>Mínimo</th></tr></thead><tbody>@if(Model.Existencias.Count==0){<tr><td colspan="6" class="empty">No hay existencias para este alcance.</td></tr>}@foreach(var x in Model.Existencias){<tr><td><strong>@x.Codigo · @x.Nombre</strong><small>@x.Categoria · @x.UnidadMedida</small></td><td>@x.Giro<small>@(x.Sede??"Sin existencia por sede")</small></td><td>@x.Cantidad.ToString("N3")</td><td>@x.CantidadReservada.ToString("N3")</td><td>@x.CantidadDisponible.ToString("N3")</td><td><span class="status-pill @(x.BajoMinimo?"inactive":"")">@x.StockMinimo.ToString("N3") @(x.BajoMinimo?"· Reponer":"")</span></td></tr>}</tbody></table></div>
<div class="inventory-actions">
@if(User.IsInRole("AdministradorGeneral")||User.IsInRole("Gerente")){<form method="post" action="/gestion/inventarios/articulos" class="entity-form"><fieldset><legend>Nuevo artículo</legend><select name="GiroNegocioId" required><option value="">Giro</option>@foreach(var x in Model.Opciones.Giros){<option value="@x.Id">@x.Nombre</option>}</select><input name="Codigo" placeholder="Código" required/><input name="Nombre" placeholder="Nombre" required/><input name="Categoria" placeholder="Categoría" required/><input name="UnidadMedida" placeholder="Unidad: kg, unidad, galón…" required/><input name="StockMinimo" type="number" min="0" step="0.001" value="0" required/><button class="button">Crear artículo</button></fieldset></form>}
<form method="post" action="/gestion/inventarios/movimientos" class="entity-form"><fieldset><legend>Registrar movimiento</legend><select name="InventarioArticuloId" required><option value="">Artículo</option>@foreach(var x in Model.Opciones.Articulos){<option value="@x.Id">@x.Nombre</option>}</select><select name="Tipo" required><option>Entrada</option><option>Salida</option><option>Transferencia</option><option>Reserva</option><option>Liberacion</option></select><select name="SedeOrigenId"><option value="">Sede origen (si aplica)</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id">@x.Nombre</option>}</select><select name="SedeDestinoId"><option value="">Sede destino (si aplica)</option>@foreach(var x in Model.Opciones.Sedes){<option value="@x.Id">@x.Nombre</option>}</select><input name="Cantidad" type="number" min="0.001" step="0.001" placeholder="Cantidad" required/><input name="Referencia" placeholder="Referencia"/><textarea name="Observacion" rows="3" placeholder="Observación"></textarea><button class="button">Registrar</button></fieldset></form></div>
<div class="section-heading compact"><span class="eyebrow">Trazabilidad</span><h2>Movimientos recientes.</h2></div><div class="responsive-table"><table><thead><tr><th>Fecha</th><th>Artículo</th><th>Tipo</th><th>Origen / destino</th><th>Cantidad</th><th>Responsable</th></tr></thead><tbody>@if(Model.Movimientos.Count==0){<tr><td colspan="6" class="empty">Sin movimientos.</td></tr>}@foreach(var m in Model.Movimientos){<tr><td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@m.Codigo · @m.Articulo</strong><small>@m.Referencia</small></td><td>@m.Tipo</td><td>@(m.SedeOrigen??"—")<small>→ @(m.SedeDestino??"—")</small></td><td>@m.Cantidad.ToString("N3") @m.UnidadMedida</td><td>@m.NombreUsuario</td></tr>}</tbody></table></div>
</div></section>
