@model GpsPaginaViewModel
@{ViewData["Title"]="GPS y monitoreo";}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion">← Gestión</a><h1>GPS y monitoreo</h1><p>Posición, velocidad, recorrido, horas de uso y alertas. Los datos de prueba se identifican como simulación externa.</p></div></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<div class="responsive-table"><table><thead><tr><th>Activo</th><th>Última posición</th><th>Telemetría</th><th>Alertas</th><th></th></tr></thead><tbody>@if(Model.Resumen.Dispositivos.Count==0){<tr><td colspan="5" class="empty">Primero registre el dispositivo de demostración.</td></tr>}@foreach(var d in Model.Resumen.Dispositivos){<tr><td><strong>@d.NombreActivo</strong><small>@d.IdentificadorExterno · @d.Proveedor</small></td><td>@d.Latitud, @d.Longitud<small>@d.FechaEvento?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td><td>@d.Velocidad?.ToString("N2") km/h<small>@d.HorasUso?.ToString("N2") h · @d.Kilometraje?.ToString("N2") km</small></td><td>@d.AlertasAbiertas</td><td><a class="text-link" href="/gestion/gps/dispositivos/@d.GpsDispositivoId">Recorrido</a>@if(User.IsInRole("AdministradorGeneral")){<form method="post" action="/gestion/gps/dispositivos/@d.GpsDispositivoId/eliminar"><button class="link-button danger">Eliminar</button></form>}</td></tr>}</tbody></table></div>
<div class="scope-grid"><form method="post" action="/gestion/gps/dispositivos" class="entity-form"><fieldset><legend>Dispositivo de prueba</legend><label>Identificador externo</label><input name="IdentificadorExterno" value="GPS-DEMO-001" required/><label>Nombre del activo</label><input name="NombreActivo" value="Unidad de demostración" required/><label>Proveedor</label><input name="Proveedor" value="GPS-Inversiones" required/><label>Velocidad máxima</label><input type="number" step=".01" name="VelocidadMaxima" value="80" required/><label>Vehículo opcional</label><select name="VehiculoId"><option value="">Activo externo sin asociación</option>@foreach(var x in Model.Opciones.Vehiculos){<option value="@x.Id">@x.Nombre</option>}</select><label>Maquinaria opcional</label><select name="MaquinariaId"><option value="">Sin maquinaria</option>@foreach(var x in Model.Opciones.Maquinarias){<option value="@x.Id">@x.Nombre</option>}</select><button class="button">Registrar dispositivo</button></fieldset></form>
<form method="post" action="/gestion/gps/simular" class="entity-form"><fieldset><legend>Simular dato de fuente externa</legend><p>El ejemplo funciona sin cambios y representa Ciudad de Guatemala.</p><label>Dispositivo</label><select name="dispositivoId" required><option value="">Seleccione</option>@foreach(var d in Model.Resumen.Dispositivos){<option value="@d.GpsDispositivoId">@d.NombreActivo</option>}</select><label>Texto recibido (JSON)</label><textarea name="datosFuente" rows="9" required placeholder='@Model.DatosFuenteEjemplo'>@Model.DatosFuenteEjemplo</textarea><small>Cambie velocidad a 95 para generar una alerta; use evento "SOS" para una alerta crítica.</small><button class="button">Simular recepción</button></fieldset></form></div>
<div class="section-heading compact"><h2>Alertas.</h2></div><div class="responsive-table"><table><thead><tr><th>Fecha</th><th>Activo</th><th>Tipo</th><th>Mensaje</th><th></th></tr></thead><tbody>@foreach(var a in Model.Resumen.Alertas){<tr><td>@a.Fecha.ToLocalTime().ToString("g")</td><td>@a.NombreActivo</td><td>@a.Severidad · @a.Tipo</td><td>@a.Mensaje</td><td>@if(!a.Atendida){<form method="post" action="/gestion/gps/alertas/@a.GpsAlertaId"><button class="button button-small">Atender</button></form>}else{<small>Atendida por @a.AtendidaPor</small>}</td></tr>}</tbody></table></div></div></section>
