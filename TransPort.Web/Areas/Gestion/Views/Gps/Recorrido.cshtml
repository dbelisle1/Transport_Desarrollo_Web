@model IReadOnlyList<GpsPosicionModel>
@{ViewData["Title"]="Recorrido GPS";}
<section class="dashboard-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/gestion/gps">← GPS</a><h1>Recorrido del dispositivo</h1><p>Eventos recibidos, ordenados desde el más reciente.</p></div></div><div class="responsive-table"><table><thead><tr><th>Evento</th><th>Coordenadas</th><th>Velocidad</th><th>Uso</th><th>Origen</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.FechaEvento.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")<small>@p.Evento</small></td><td>@p.Latitud, @p.Longitud</td><td>@p.Velocidad.ToString("N2") km/h</td><td>@p.HorasUso?.ToString("N2") h<small>@p.Kilometraje?.ToString("N2") km</small></td><td>@p.OrigenDato<details><summary>Texto fuente</summary><code>@p.DatosFuente</code></details></td></tr>}</tbody></table></div></div></section>
