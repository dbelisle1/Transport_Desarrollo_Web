@model CatalogoFormViewModel
@{ var editando = Model.Id > 0; ViewData["Title"] = editando ? $"Editar {Model.Singular}" : $"Nuevo {Model.Singular}"; }
<section class="dashboard-page admin-page">
    <div class="container narrow">
        <div class="page-heading">
            <div>
                <a class="back-link" href="/admin/catalogos/@Model.Tipo">← @Model.Titulo</a>
                <h1>@ViewData["Title"]</h1>
                <p>Los cambios serán validados por la API y registrados en auditoría.</p>
            </div>
        </div>
        <form method="post" class="entity-form">
            <input asp-for="Id" type="hidden" />
            <input asp-for="Tipo" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <fieldset>
                <legend>Datos del @Model.Singular</legend>
                @if (Model.Protegido)
                {
                    <p class="field-help">AdministradorGeneral es un rol protegido: puede cambiar su descripción, pero no su nombre ni su estado.</p>
                }
                <div class="form-grid catalog-form-grid">
                    <div>
                        <label asp-for="Nombre"></label>
                        <input asp-for="Nombre" readonly="@Model.Protegido" />
                        <span asp-validation-for="Nombre" class="validation"></span>
                    </div>
                    @if (Model.Protegido)
                    {
                        <label class="check-line"><input type="checkbox" checked disabled /> <span>Registro activo</span></label>
                        <input type="hidden" name="EsActivo" value="true" />
                    }
                    else
                    {
                        <label class="check-line"><input asp-for="EsActivo" /> <span>Registro activo</span></label>
                    }
                    <div class="full-field">
                        <label asp-for="Descripcion"></label>
                        <textarea asp-for="Descripcion" rows="5"></textarea>
                        <span asp-validation-for="Descripcion" class="validation"></span>
                    </div>
                </div>
            </fieldset>
            <div class="form-actions">
                <a class="text-link" href="/admin/catalogos/@Model.Tipo">Cancelar</a>
                <button class="button" type="submit">@(editando ? "Guardar cambios" : $"Crear {Model.Singular}")</button>
            </div>
        </form>
    </div>
</section>
