@model CatalogoFiltroViewModel
@{ ViewData["Title"] = Model.Titulo; }
<section class="dashboard-page admin-page">
    <div class="container">
        <div class="page-heading">
            <div>
                <a class="back-link" href="/admin">← Administración</a>
                <h1>@Model.Titulo</h1>
                <p>@Model.Descripcion</p>
            </div>
            <a class="button" href="/admin/catalogos/@Model.Tipo/crear">Nuevo @Model.Singular</a>
        </div>
        <nav class="catalog-tabs" aria-label="Catálogos administrativos">
            <a class="@(Model.Tipo == "roles" ? "active" : null)" href="/admin/catalogos/roles">Roles</a>
            <a class="@(Model.Tipo == "giros" ? "active" : null)" href="/admin/catalogos/giros">Giros</a>
            <a class="@(Model.Tipo == "sedes" ? "active" : null)" href="/admin/catalogos/sedes">Sedes</a>
        </nav>
        @if (TempData["Exito"] is not null) { <div class="alert success">@TempData["Exito"]</div> }
        @if (TempData["Error"] is not null) { <div class="alert error">@TempData["Error"]</div> }
        <form method="get" class="filter-bar catalog-filter">
            <div>
                <label for="busqueda">Buscar</label>
                <input id="busqueda" name="busqueda" value="@Model.Busqueda" placeholder="Nombre o descripción" />
            </div>
            <div>
                <label for="estado">Estado</label>
                <select id="estado" name="esActivo">
                    <option value="">Todos</option>
                    <option value="true" selected="@(Model.EsActivo == true)">Activos</option>
                    <option value="false" selected="@(Model.EsActivo == false)">Inactivos</option>
                </select>
            </div>
            <button class="button button-small" type="submit">Filtrar</button>
            <a class="text-link" href="/admin/catalogos/@Model.Tipo">Limpiar</a>
        </form>
        <div class="responsive-table">
            <table>
                <thead><tr><th>Nombre</th><th>Descripción</th><th>Creación</th><th>Estado</th><th class="actions-col">Acciones</th></tr></thead>
                <tbody>
                @if (Model.Elementos.Count == 0)
                {
                    <tr><td colspan="5" class="empty">No se encontraron registros.</td></tr>
                }
                @foreach (var item in Model.Elementos)
                {
                    var protegido = Model.Tipo == "roles" && item.Nombre.Equals("AdministradorGeneral", StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td data-label="Nombre"><strong>@item.Nombre</strong>@if (protegido) { <small>Rol protegido del sistema</small> }</td>
                        <td data-label="Descripción">@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción" : item.Descripcion)</td>
                        <td data-label="Creación">@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td data-label="Estado"><span class="status-pill @(item.EsActivo ? "" : "inactive")">@(item.EsActivo ? "Activo" : "Inactivo")</span></td>
                        <td data-label="Acciones" class="row-actions">
                            <a href="/admin/catalogos/@Model.Tipo/@item.Id/editar">Editar</a>
                            @if (!protegido)
                            {
                                <form method="post" action="/admin/catalogos/@Model.Tipo/@item.Id/estado"><button class="link-button" type="submit">@(item.EsActivo ? "Desactivar" : "Activar")</button></form>
                                <form method="post" action="/admin/catalogos/@Model.Tipo/@item.Id/eliminar" data-confirm="¿Eliminar lógicamente este @Model.Singular?"><button class="link-button danger" type="submit">Eliminar</button></form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
