@model UsuarioFiltroViewModel
@{ ViewData["Title"]="Usuarios"; }
<section class="dashboard-page admin-page"><div class="container"><div class="page-heading"><div><a class="back-link" href="/admin">← Administración</a><h1>Usuarios</h1><p>Gestione acceso, estado y alcance organizacional.</p></div><a class="button" href="/admin/usuarios/crear">Nuevo usuario</a></div>
@if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}@if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
<form method="get" class="filter-bar"><div><label for="busqueda">Buscar</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" placeholder="Nombre, usuario o correo" /></div><div><label for="estado">Estado</label><select id="estado" name="esActivo"><option value="">Todos</option><option value="true" selected="@(Model.EsActivo==true)">Activos</option><option value="false" selected="@(Model.EsActivo==false)">Inactivos</option></select></div><div><label for="rol">Rol</label><select id="rol" name="rolId"><option value="">Todos</option>@foreach(var rol in Model.Roles){<option value="@rol.Id" selected="@(Model.RolId==rol.Id)">@rol.Nombre</option>}</select></div><button class="button button-small" type="submit">Filtrar</button><a class="text-link" href="/admin/usuarios">Limpiar</a></form>
<div class="responsive-table"><table><thead><tr><th>Usuario</th><th>Nombre</th><th>Roles</th><th>Estado</th><th class="actions-col">Acciones</th></tr></thead><tbody>@if(Model.Usuarios.Count==0){<tr><td colspan="5" class="empty">No se encontraron usuarios.</td></tr>}@foreach(var usuario in Model.Usuarios){<tr><td data-label="Usuario"><strong>@usuario.NombreUsuario</strong><small>@usuario.Correo</small></td><td data-label="Nombre">@usuario.Nombre @usuario.Apellido</td><td data-label="Roles">@(string.IsNullOrWhiteSpace(usuario.Roles)?"Sin roles":usuario.Roles)</td><td data-label="Estado"><span class="status-pill @(usuario.EsActivo?"":"inactive")">@(usuario.EsActivo?"Activo":"Inactivo")</span></td><td data-label="Acciones" class="row-actions"><a href="/admin/usuarios/@usuario.UsuarioId/editar">Editar</a><form method="post" action="/admin/usuarios/@usuario.UsuarioId/estado">@Html.AntiForgeryToken()<button class="link-button" type="submit">@(usuario.EsActivo?"Desactivar":"Activar")</button></form><form method="post" action="/admin/usuarios/@usuario.UsuarioId/eliminar" data-confirm="¿Eliminar lógicamente este usuario?">@Html.AntiForgeryToken()<button class="link-button danger" type="submit">Eliminar</button></form></td></tr>}</tbody></table></div></div></section>
