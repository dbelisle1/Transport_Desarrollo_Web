@model UsuarioFormViewModel
@{ var editando=Model.UsuarioId>0; ViewData["Title"]=editando?"Editar usuario":"Nuevo usuario"; }
<section class="dashboard-page admin-page"><div class="container narrow"><div class="page-heading"><div><a class="back-link" href="/admin/usuarios">← Usuarios</a><h1>@ViewData["Title"]</h1><p>Los cambios de permisos serán verificados también por la API.</p></div></div><form method="post" class="entity-form"><input asp-for="UsuarioId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div><fieldset><legend>Datos de acceso</legend><div class="form-grid"><div><label asp-for="NombreUsuario"></label><input asp-for="NombreUsuario" autocomplete="off" /><span asp-validation-for="NombreUsuario" class="validation"></span></div><div><label asp-for="Correo"></label><input asp-for="Correo" /><span asp-validation-for="Correo" class="validation"></span></div><div><label asp-for="Nombre"></label><input asp-for="Nombre" /><span asp-validation-for="Nombre" class="validation"></span></div><div><label asp-for="Apellido"></label><input asp-for="Apellido" /><span asp-validation-for="Apellido" class="validation"></span></div>@if(!editando){<div><label asp-for="Clave"></label><input asp-for="Clave" autocomplete="new-password" /><span asp-validation-for="Clave" class="validation"></span><small>Solo prototipo: se almacena como texto plano.</small></div>}<label class="check-line"><input asp-for="EsActivo" /> <span>Usuario activo</span></label></div></fieldset>
<fieldset><legend>Roles</legend><div class="check-grid">@foreach(var item in Model.RolesDisponibles){<label class="check-card"><input type="checkbox" name="RolesSeleccionados" value="@item.Id" checked="@Model.RolesSeleccionados.Contains(item.Id)" /><span><strong>@item.Nombre</strong><small>@item.Descripcion</small></span></label>}</div></fieldset>
<fieldset><legend>Giros de negocio</legend><div class="check-grid">@foreach(var item in Model.GirosDisponibles){<label class="check-card"><input type="checkbox" name="GirosSeleccionados" value="@item.Id" checked="@Model.GirosSeleccionados.Contains(item.Id)" /><span><strong>@item.Nombre</strong><small>@item.Descripcion</small></span></label>}</div></fieldset>
<fieldset><legend>Sedes</legend><div class="check-grid">@foreach(var item in Model.SedesDisponibles){<label class="check-card"><input type="checkbox" name="SedesSeleccionadas" value="@item.Id" checked="@Model.SedesSeleccionadas.Contains(item.Id)" /><span><strong>@item.Nombre</strong><small>@item.Descripcion</small></span></label>}</div></fieldset><div class="form-actions"><a class="text-link" href="/admin/usuarios">Cancelar</a><button class="button" type="submit">@(editando?"Guardar cambios":"Crear usuario")</button></div></form></div></section>
