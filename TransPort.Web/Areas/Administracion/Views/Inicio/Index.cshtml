@model DashboardModel
@{ ViewData["Title"] = "Administración"; }
<section class="dashboard-page admin-page">
    <div class="container">
        <div class="dashboard-hero">
            <div><span class="eyebrow">Administración general</span><h1>Control central</h1><p>Bienvenido, @User.Identity?.Name. Datos registrados actualmente en TransPortDB.</p></div>
            <a class="button" href="/admin/usuarios">Administrar usuarios</a>
        </div>
        @if (ViewBag.Error is not null) { <div class="alert error">@ViewBag.Error</div> }
        <div class="stats-grid">
            <article><span>Usuarios</span><strong>@Model.Usuarios</strong><small>registros vigentes</small></article>
            <article><span>Clientes</span><strong>@Model.Clientes</strong><small>empresas registradas</small></article>
            <article><span>Giros</span><strong>@Model.Giros</strong><small>unidades de negocio</small></article>
            <article><span>Sedes</span><strong>@Model.Sedes</strong><small>ubicaciones registradas</small></article>
        </div>
        <div class="admin-grid">
            <a class="admin-card active" href="/admin/usuarios"><span class="module-icon">◎</span><div><h2>Usuarios y permisos</h2><p>Crear, editar, desactivar y administrar asignaciones.</p></div><b>Disponible →</b></a>
            <a class="admin-card active" href="/admin/clientes"><span class="module-icon">◇</span><div><h2>Clientes</h2><p>Administrar empresas, usuarios asociados y giros contratados.</p></div><b>Disponible →</b></a>
            <a class="admin-card active" href="/admin/catalogos"><span class="module-icon">▦</span><div><h2>Roles, giros y sedes</h2><p>Mantener la estructura organizacional utilizada por usuarios y clientes.</p></div><b>Disponible →</b></a>
            <article class="admin-card"><span class="module-icon">▤</span><div><h2>Reportes consolidados</h2><p>Espacio reservado para próximas fases.</p></div><b>Pendiente</b></article>
        </div>
    </div>
</section>
