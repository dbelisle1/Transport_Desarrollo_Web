@model ClienteFiltroViewModel
@{ ViewData["Title"] = "Clientes"; }
<section class="dashboard-page admin-page">
    <div class="container">
        <div class="page-heading">
            <div>
                <a class="back-link" href="/admin">← Administración</a>
                <h1>Clientes</h1>
                <p>Gestione empresas cliente, usuarios asociados y giros contratados.</p>
            </div>
            <a class="button" href="/admin/clientes/crear">Nuevo cliente</a>
        </div>
        @if (TempData["Exito"] is not null) { <div class="alert success">@TempData["Exito"]</div> }
        @if (TempData["Error"] is not null) { <div class="alert error">@TempData["Error"]</div> }
        <form method="get" class="filter-bar client-filter">
            <div>
                <label for="busqueda">Buscar</label>
                <input id="busqueda" name="busqueda" value="@Model.Busqueda" placeholder="Empresa, NIT o correo" />
            </div>
            <div>
                <label for="estado">Estado</label>
                <select id="estado" name="esActivo">
                    <option value="">Todos</option>
                    <option value="true" selected="@(Model.EsActivo == true)">Activos</option>
                    <option value="false" selected="@(Model.EsActivo == false)">Inactivos</option>
                </select>
            </div>
            <button class="button button-small" type="submit">Filtrar</button>
            <a class="text-link" href="/admin/clientes">Limpiar</a>
        </form>
        <div class="responsive-table">
            <table>
                <thead><tr><th>Empresa</th><th>Usuarios</th><th>Giros</th><th>Estado</th><th class="actions-col">Acciones</th></tr></thead>
                <tbody>
                @if (Model.Clientes.Count == 0)
                {
                    <tr><td colspan="5" class="empty">No se encontraron clientes.</td></tr>
                }
                @foreach (var cliente in Model.Clientes)
                {
                    <tr>
                        <td data-label="Empresa">
                            <strong>@cliente.Nombre</strong>
                            <small>NIT: @(cliente.Nit ?? "No registrado")</small>
                            <small>@(cliente.CorreoContacto ?? "Sin correo de contacto")</small>
                        </td>
                        <td data-label="Usuarios">@(string.IsNullOrWhiteSpace(cliente.Usuarios) ? "Sin usuarios" : cliente.Usuarios)</td>
                        <td data-label="Giros">@(string.IsNullOrWhiteSpace(cliente.Giros) ? "Sin giros" : cliente.Giros)</td>
                        <td data-label="Estado"><span class="status-pill @(cliente.EsActivo ? "" : "inactive")">@(cliente.EsActivo ? "Activo" : "Inactivo")</span></td>
                        <td data-label="Acciones" class="row-actions">
                            <a href="/admin/clientes/@cliente.ClienteId/editar">Editar</a>
                            <form method="post" action="/admin/clientes/@cliente.ClienteId/estado">@Html.AntiForgeryToken()<button class="link-button" type="submit">@(cliente.EsActivo ? "Desactivar" : "Activar")</button></form>
                            <form method="post" action="/admin/clientes/@cliente.ClienteId/eliminar" data-confirm="¿Eliminar lógicamente este cliente?">@Html.AntiForgeryToken()<button class="link-button danger" type="submit">Eliminar</button></form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
