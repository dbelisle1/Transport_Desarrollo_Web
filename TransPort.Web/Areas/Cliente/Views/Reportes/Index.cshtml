@model ReporteClientePaginaViewModel
@{ViewData["Title"]="Mis reportes";var r=Model.Reporte;}
<section class="dashboard-page"><div class="container">
<div class="page-heading"><div><a class="back-link" href="/cliente">← Portal del cliente</a><h1>Reportes de mis empresas</h1><p>Solo se incluyen empresas y operaciones asociadas con su cuenta.</p></div></div>
<form method="get" class="filter-bar"><input type="date" name="desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" required/><input type="date" name="hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" required/><select name="clienteId"><option value="">Todas mis empresas</option>@foreach(var x in Model.Empresas){<option value="@x.ClienteId" selected="@(Model.ClienteId==x.ClienteId)">@x.Nombre</option>}</select><button class="button button-small">Generar</button></form>
<div class="stats-grid client-stats"><article><span>Solicitudes</span><strong>@r.Resumen.Pedidos</strong><small>@r.Resumen.Completados completadas</small></article><article><span>Viajes</span><strong>@r.Resumen.Viajes</strong><small>@r.Resumen.Entregados entregados</small></article><article><span>Contratos</span><strong>@r.Resumen.Contratos</strong><small>@r.Resumen.MontoContratos.ToString("C2")</small></article><article><span>Obras</span><strong>@r.Resumen.Proyectos</strong><small>@r.Resumen.AvancePromedio.ToString("N2")% de avance promedio</small></article></div>
<div class="section-heading compact"><span class="eyebrow">Empresas</span><h2>Resumen autorizado.</h2></div><div class="responsive-table"><table><thead><tr><th>Empresa</th><th>Solicitudes</th><th>Transporte</th><th>Maquinaria</th><th>Construcción</th><th>Transacciones</th></tr></thead><tbody>@if(r.Empresas.Count==0){<tr><td colspan="6" class="empty">No hay empresas autorizadas para el filtro.</td></tr>}@foreach(var x in r.Empresas){<tr><td><strong>@x.Cliente</strong></td><td>@x.Pedidos<small>@x.MontoCotizado.ToString("C2") cotizado</small></td><td>@x.Viajes viajes<small>@x.PesoTransportado.ToString("N2") t</small></td><td>@x.Contratos contratos<small>@x.MontoContratos.ToString("C2")</small></td><td>@x.Proyectos obras<small>@x.AvancePromedio.ToString("N2")% avance</small></td><td>@x.IngresosRegistrados.ToString("C2")</td></tr>}</tbody></table></div>
<div class="section-heading compact"><span class="eyebrow">Evolución</span><h2>Actividad mensual.</h2></div><div class="responsive-table"><table><thead><tr><th>Período</th><th>Solicitudes</th><th>Operaciones</th><th>Transacciones registradas</th></tr></thead><tbody>@foreach(var x in r.Periodos){<tr><td>@x.Periodo</td><td>@x.Pedidos</td><td>@x.Operaciones</td><td>@x.IngresosRegistrados.ToString("C2")</td></tr>}</tbody></table></div>
</div></section>
