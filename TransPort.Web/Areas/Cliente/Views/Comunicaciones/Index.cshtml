@model ComunicacionPaginaViewModel
@{ ViewData["Title"] = "Comunicaciones"; }
<section class="dashboard-page"><div class="container">
    <div class="dashboard-hero"><div><span class="eyebrow">Atención al cliente</span><h1>Comunicaciones</h1><p>Consulte conversaciones anteriores o inicie una solicitud vinculada con su empresa, servicio o pedido.</p></div><a class="button secondary" href="/cliente">Volver al panel</a></div>
    @if(TempData["Exito"] is not null){<div class="alert success">@TempData["Exito"]</div>}
    @if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}

    <div class="content-grid">
        <section class="info-panel">
            <span class="eyebrow">Nueva conversación</span><h2>¿En qué podemos ayudarle?</h2>
            <form method="post" action="/cliente/comunicaciones/crear" class="form-grid">
                @Html.AntiForgeryToken()
                <label>Empresa<select name="ClienteId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.Clientes){<option value="@x.Id" selected="@(Model.Nueva.ClienteId==x.Id)">@x.Nombre</option>}</select></label>
                <label>Servicio contratado<select name="GiroNegocioId" required><option value="">Seleccione</option>@foreach(var x in Model.Opciones.Giros){<option value="@x.Id" selected="@(Model.Nueva.GiroNegocioId==x.Id)">@x.Nombre</option>}</select></label>
                <label>Pedido relacionado (opcional)<select name="PedidoId"><option value="">Ninguno</option>@foreach(var x in Model.Opciones.Pedidos){<option value="@x.Id">@x.Nombre</option>}</select></label>
                <label>Asunto<input name="Asunto" maxlength="180" minlength="3" required placeholder="Consulta sobre mi pedido" /></label>
                <label class="full-width">Mensaje<textarea name="MensajeInicial" maxlength="2000" minlength="2" required placeholder="Describa su consulta o solicitud"></textarea></label>
                <div class="full-width"><button class="button" type="submit">Iniciar comunicación</button></div>
            </form>
        </section>
        <section class="info-panel">
            <span class="eyebrow">Bandeja</span><h2>Sus conversaciones</h2>
            <form method="get" class="filter-bar"><select name="estado"><option value="">Todos los estados</option><option selected="@(Model.Estado=="Abierta")">Abiertas</option><option selected="@(Model.Estado=="Cerrada")">Cerradas</option></select><input name="busqueda" value="@Model.Busqueda" placeholder="Buscar por asunto" /><button class="button secondary" type="submit">Filtrar</button></form>
            <div class="responsive-table"><table><thead><tr><th>Asunto</th><th>Empresa / servicio</th><th>Estado</th><th>Actividad</th><th></th></tr></thead><tbody>
            @if(Model.Comunicaciones.Count==0){<tr><td colspan="5" class="empty">No hay comunicaciones para mostrar.</td></tr>}
            @foreach(var x in Model.Comunicaciones){<tr><td><strong>@x.Asunto</strong><small>@x.Mensajes mensaje(s) · @(x.PedidoId is null?"Sin pedido":$"Pedido #{x.PedidoId}")</small></td><td>@x.Cliente<small>@x.Giro</small></td><td><span class="status-pill">@x.Estado</span></td><td>@x.UltimaActividad.ToString("dd/MM/yyyy HH:mm")</td><td><a class="text-link" href="/cliente/comunicaciones/@x.ComunicacionHiloId">Abrir</a></td></tr>}
            </tbody></table></div>
        </section>
    </div>
</div></section>
