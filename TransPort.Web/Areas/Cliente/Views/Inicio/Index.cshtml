@{ ViewData["Title"] = "Panel del cliente"; var empresas = User.Claims.Where(c => c.Type == "cliente").Select(c => c.Value).ToArray(); }
<section class="dashboard-page"><div class="container"><div class="dashboard-hero"><div><span class="eyebrow">Portal de clientes</span><h1>Hola, @User.Identity?.Name</h1><p>Consulte sus empresas vinculadas y los módulos disponibles para su cuenta.</p></div><span class="status-pill">Sesión activa</span></div>
<div class="info-panel"><span class="eyebrow">Empresas asociadas</span>@if(empresas.Length==0){<p>No hay empresas asociadas a esta cuenta.</p>}else{<div class="chip-list">@foreach(var empresa in empresas){<span class="chip">@empresa</span>}</div>}</div>
<div class="section-heading compact"><span class="eyebrow">Próximamente</span><h2>Su operación a la vista.</h2></div><div class="module-grid"><article class="module-card disabled"><span class="module-icon">□</span><h3>Pedidos</h3><p>Solicitudes y documentos de sus operaciones.</p><span>Pendiente</span></article><article class="module-card disabled"><span class="module-icon">↗</span><h3>Seguimiento</h3><p>Estado de servicios y movimientos vinculados.</p><span>Pendiente</span></article><article class="module-card disabled"><span class="module-icon">◎</span><h3>Operaciones</h3><p>Resumen de actividad por giro de negocio.</p><span>Pendiente</span></article><article class="module-card disabled"><span class="module-icon">✉</span><h3>Comunicación</h3><p>Canal directo con el equipo asignado.</p><span>Pendiente</span></article></div></div></section>
