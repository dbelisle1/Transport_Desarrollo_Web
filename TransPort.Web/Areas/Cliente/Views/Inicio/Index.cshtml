@model PortalClienteResumenModel
@{ ViewData["Title"] = "Panel del cliente"; }
<section class="dashboard-page"><div class="container">
    <div class="dashboard-hero"><div><span class="eyebrow">Portal operativo del cliente</span><h1>Hola, @User.Identity?.Name</h1><p>Consulte sus empresas, servicios contratados y solicitudes recientes.</p></div><a class="button" href="/cliente/pedidos/crear">Nueva solicitud</a></div>
    @if(TempData["Error"] is not null){<div class="alert error">@TempData["Error"]</div>}
    <div class="stats-grid client-stats"><article><span>Solicitudes</span><strong>@Model.TotalSolicitudes</strong><small>Total visible</small></article><article><span>Nuevas</span><strong>@Model.Solicitadas</strong><small>Pendientes de revisión</small></article><article><span>En gestión</span><strong>@Model.EnGestion</strong><small>Con seguimiento activo</small></article><article><span>Completadas</span><strong>@Model.Completadas</strong><small>Servicios finalizados</small></article></div>
    <div class="section-heading compact"><span class="eyebrow">Empresas y servicios</span><h2>Su alcance autorizado.</h2></div>
    @if(Model.Empresas.Count==0){<div class="info-panel"><p>No hay empresas asociadas a esta cuenta.</p></div>}else{<div class="client-company-grid">@foreach(var empresa in Model.Empresas){<article class="info-panel"><h3>@empresa.Nombre</h3><p>NIT: @(empresa.Nit??"No registrado")<br />@(empresa.CorreoContacto??"Sin correo de contacto")</p><span class="eyebrow">Servicios contratados</span>@if(empresa.ServiciosContratados.Count==0){<small>Sin giros contratados.</small>}else{<div class="chip-list">@foreach(var servicio in empresa.ServiciosContratados){<span class="chip">@servicio.Nombre</span>}</div>}</article>}</div>}
    <div class="section-heading compact"><span class="eyebrow">Actividad</span><h2>Solicitudes recientes.</h2></div>
    <div class="responsive-table"><table><thead><tr><th>Solicitud</th><th>Empresa</th><th>Servicio</th><th>Estado</th><th>Fecha</th><th></th></tr></thead><tbody>@if(Model.SolicitudesRecientes.Count==0){<tr><td colspan="6" class="empty">Todavía no hay solicitudes.</td></tr>}@foreach(var p in Model.SolicitudesRecientes){<tr><td><strong>@p.Titulo</strong><small>@p.TipoSolicitud #@p.PedidoId</small></td><td>@p.Cliente</td><td>@p.Giro</td><td><span class="status-pill">@p.Estado</span></td><td>@p.FechaCreacion.ToString("dd/MM/yyyy")</td><td><a class="text-link" href="/cliente/pedidos/@p.PedidoId">Ver</a></td></tr>}</tbody></table></div>
    <div class="section-heading compact"><span class="eyebrow">Módulos</span><h2>Herramientas disponibles.</h2></div><div class="module-grid"><a class="module-card active" href="/cliente/pedidos"><span class="module-icon">□</span><h3>Pedidos</h3><p>Solicitudes, cotizaciones, reuniones y @Model.Documentos documentos.</p><span>Disponible</span></a><article class="module-card disabled"><span class="module-icon">↗</span><h3>Seguimiento operativo</h3><p>Se habilitará al integrar transporte y operaciones.</p><span>Pendiente de M18</span></article><article class="module-card disabled"><span class="module-icon">◎</span><h3>Reportes</h3><p>Se habilitará con el módulo de reportes consolidados.</p><span>Pendiente de M26</span></article><a class="module-card active" href="/cliente/comunicaciones"><span class="module-icon">✉</span><h3>Comunicación</h3><p>Consultas y seguimiento con el personal de la empresa.</p><span>Disponible</span></a></div>
</div></section>
