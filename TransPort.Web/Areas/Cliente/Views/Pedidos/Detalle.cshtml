@model PedidoDetalleViewModel
@{ ViewData["Title"] = Model.Pedido.Titulo; var p=Model.Pedido; }
<section class="dashboard-page"><div class="container narrow">
    <div class="page-heading"><div><a class="back-link" href="/cliente/pedidos">← Mis solicitudes</a><span class="eyebrow">@p.TipoSolicitud #@p.PedidoId</span><h1>@p.Titulo</h1><p>@p.Cliente · @p.Giro</p></div><span class="status-pill">@p.Estado</span></div>
    @if (TempData["Exito"] is not null) { <div class="alert success">@TempData["Exito"]</div> } @if (TempData["Error"] is not null) { <div class="alert error">@TempData["Error"]</div> }
    <div class="detail-grid"><article class="info-panel"><h2>Detalle</h2><p>@p.Descripcion</p><dl><dt>Responsable</dt><dd>@(p.Vendedor ?? "Pendiente de asignar")</dd><dt>Fecha requerida</dt><dd>@(p.FechaRequerida?.ToString("dd/MM/yyyy") ?? "No indicada")</dd><dt>Monto cotizado</dt><dd>@(p.MontoCotizado?.ToString("C2") ?? "Pendiente")</dd><dt>Reunión</dt><dd>@(p.FechaReunionUtc?.ToString("dd/MM/yyyy HH:mm") ?? "No programada") @if(!string.IsNullOrWhiteSpace(p.EnlaceReunion)){<a class="text-link" href="@p.EnlaceReunion" target="_blank" rel="noopener">Abrir enlace</a>}</dd></dl></article>
    <article class="info-panel"><h2>Documentos</h2>@if(p.Documentos.Count==0){<p class="field-help">Sin documentos vinculados.</p>}else{<ul class="document-list">@foreach(var d in p.Documentos){<li><a href="@d.Url" target="_blank" rel="noopener"><strong>@d.Nombre</strong><small>@d.TipoDocumento · @d.NombreUsuario</small></a></li>}</ul>}</article></div>
    <div class="detail-grid"><form method="post" action="/cliente/pedidos/@p.PedidoId/comentar" class="entity-form"><fieldset><legend>Agregar comentario</legend><textarea name="comentario" rows="4" maxlength="1000" required></textarea><button class="button button-small" type="submit">Comentar</button></fieldset></form><form method="post" action="/cliente/pedidos/@p.PedidoId/documentos" class="entity-form"><fieldset><legend>Vincular documento</legend><input name="nombre" placeholder="Nombre" maxlength="200" required /><input name="tipoDocumento" placeholder="Tipo: cotización, orden…" maxlength="60" required /><input name="url" type="url" placeholder="https://..." maxlength="1000" required /><button class="button button-small" type="submit">Vincular</button></fieldset></form></div>
    <section class="timeline"><h2>Historial</h2>@foreach(var h in p.Historial){<article><span></span><div><strong>@h.EstadoNuevo</strong><small>@h.Fecha.ToString("dd/MM/yyyy HH:mm") · @h.NombreUsuario</small>@if(!string.IsNullOrWhiteSpace(h.Comentario)){<p>@h.Comentario</p>}</div></article>}</section>
</div></section>
