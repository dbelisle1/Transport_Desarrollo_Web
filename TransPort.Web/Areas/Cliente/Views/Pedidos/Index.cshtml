@model PedidoFiltroViewModel
@{ ViewData["Title"] = "Mis solicitudes"; }
<section class="dashboard-page"><div class="container">
    <div class="page-heading"><div><a class="back-link" href="/cliente">← Portal del cliente</a><h1>Mis solicitudes</h1><p>Consulte pedidos, cotizaciones y reuniones en un solo lugar.</p></div><a class="button" href="/cliente/pedidos/crear">Nueva solicitud</a></div>
    @if (TempData["Exito"] is not null) { <div class="alert success">@TempData["Exito"]</div> }
    @if (TempData["Error"] is not null) { <div class="alert error">@TempData["Error"]</div> }
    <form method="get" class="filter-bar client-filter"><div><label for="busqueda">Buscar</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" placeholder="Título, empresa o giro" /></div><div><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option>@foreach(var estado in new[]{"Solicitado","EnRevision","Cotizado","Aprobado","EnProceso","Completado","Rechazado","Cancelado"}){<option value="@estado" selected="@(Model.Estado == estado)">@estado</option>}</select></div><button class="button button-small" type="submit">Filtrar</button><a class="text-link" href="/cliente/pedidos">Limpiar</a></form>
    <div class="responsive-table"><table><thead><tr><th>Solicitud</th><th>Servicio</th><th>Estado</th><th>Fecha</th><th></th></tr></thead><tbody>
    @if(Model.Pedidos.Count==0){<tr><td colspan="5" class="empty">No hay solicitudes registradas.</td></tr>}
    @foreach(var item in Model.Pedidos){<tr><td><strong>@item.Titulo</strong><small>@item.TipoSolicitud · @item.Cliente</small></td><td>@item.Giro<small>@(item.Vendedor ?? "Sin responsable asignado")</small></td><td><span class="status-pill">@item.Estado</span></td><td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td><td><a class="text-link" href="/cliente/pedidos/@item.PedidoId">Ver detalle</a></td></tr>}
    </tbody></table></div>
</div></section>
